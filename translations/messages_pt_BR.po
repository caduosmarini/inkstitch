#. description of font in fonts/tt_directors
#: inkstitch-fonts-metadata.py:268
msgid "TT  Directors is a satin font suited for directing."
msgstr "TT Directors é uma fonte de ponto cetim adequada para quem dirige."

#. description of font in fonts/tt_masters
#: inkstitch-fonts-metadata.py:270
msgid "TT Masters is a satin font suited for heavy typing :)"
msgstr ""
"TT Masters é uma fonte de ponto cetim adequada para digitação intensa :)"

#. description of font in fonts/venezia
#: inkstitch-fonts-metadata.py:272
msgid "A serif satin font"
msgstr "Uma fonte com serifa em ponto cetim"

#. description of font in fonts/venezia_small
#: inkstitch-fonts-metadata.py:274
msgid ""
"Venezia small is an altered version of Venezia to allow a greater scaling "
