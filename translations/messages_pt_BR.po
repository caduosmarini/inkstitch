#. description of font in fonts/abecedaire
#: inkstitch-fonts-metadata.py:2
msgid "Abécédaire AGS is a cross stitch font."
msgstr "Abécédaire AGS é uma fonte de ponto cruz."

#. description of font in fonts/abecedaire_small
#: inkstitch-fonts-metadata.py:4
msgid ""
"This font is an altered version of Abécédaire AGS, to allow a greater "
"scaling down. The use of both thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Abécédaire AGS que permite reduzi-la "
"mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/ags_garamond_latin_grec
#: inkstitch-fonts-metadata.py:6
msgid ""
"AGS Γαραμου Garamond contains all the letters of the latin and greek "
"alphabets and cover most european languages."
msgstr ""
"AGS Γαραμου Garamond contém todas as letras dos alfabetos latino e grego e "
"abrange a maioria dos idiomas europeus."

#. description of font in fonts/alchemy
#: inkstitch-fonts-metadata.py:8
msgid "Alchemy is a satin font with a twist !"
msgstr "Alchemy é uma fonte de ponto cetim com um toque diferente!"

#. description of font in fonts/allegria20
#: inkstitch-fonts-metadata.py:10
msgid "Running stitch font"
msgstr "Fonte de ponto corrido"

#. description of font in fonts/allegria55
#: inkstitch-fonts-metadata.py:12
msgid "Satin font"
msgstr "Fonte acetinada"

#. description of font in fonts/ambigue
#: inkstitch-fonts-metadata.py:14
msgid ""
"Ambigüe is a mix of satin and bean stitch font with a subtle harmony of "
"disorder. You may ignore the hidden black running stitches (they are the "
"original letters) or use them to customize this font as you like."
msgstr ""
"Ambigue é uma mistura de ponto cetim e ponto feijão com uma (sutil) harmonia"
" de desordem. Você pode ignorar os pontos pretos ocultos (são as letras "
"originais) ou usá-los para personalizar esta fonte como preferir."

#. description of font in fonts/amitaclo
#: inkstitch-fonts-metadata.py:16
msgid "Amitaclo is a script satin font. Every satin has zigzag underlay"
msgstr ""
"Amitaclo é uma fonte de cetim script. Cada cetim tem um subtexto em zigue-"
"zague"

#. description of font in fonts/amitaclo_small
#: inkstitch-fonts-metadata.py:18
msgid ""
"This font is an altered version of Amitaclo, to allow a greater scaling "
"down. The use of both  thin thread (60) and thin needle (60) is mandatory."
msgstr ""
"Esta fonte é uma versão alterada da Amitaclo, para permitir uma escala "
"menor. O uso de linha fina (60) e agulha fina (60) é obrigatório."

#. description of font in fonts/animals
#: inkstitch-fonts-metadata.py:20
msgid ""
"cross stitch font, each letter includes an animal with English name starting"
" with the letter"
msgstr ""
"Fonte de ponto cruz em que cada letra inclui um animal cujo nome em inglês "
"começa com essa letra"

#. description of font in fonts/animaux
#: inkstitch-fonts-metadata.py:22
msgid ""
"cross stitch font, each letter includes an animal with French name starting "
"with the letter"
msgstr ""
"Fonte de ponto cruz em que cada letra inclui um animal cujo nome em francês "
"começa com essa letra"

#. description of font in fonts/apesplit
#: inkstitch-fonts-metadata.py:24
msgid "120 mm tall monogram font."
msgstr "Fonte de monograma com 120 mm de altura."

#. description of font in fonts/apex_lake
#: inkstitch-fonts-metadata.py:26
msgid ""
"Apex Lake is a large ornate capital letters font. It contains only 38 glyphs"
" : A-Z,0-9,! and ?."
msgstr ""
"Apex Lake é uma fonte grande e ornamentada com letras maiúsculas. Ela contém"
" apenas 38 glifos: A-Z, 0–9, ! e ?."

#. description of font in fonts/apex_simple_AGS
#: inkstitch-fonts-metadata.py:28
msgid "Apex Simple AGS is a satin companion font for Apex Lake AGS."
msgstr ""
"Apex Simple AGS é uma fonte complementar acetinada para Apex Lake AGS."

#. description of font in fonts/apex_simple_small_AGS
#: inkstitch-fonts-metadata.py:30
msgid ""
"Apex Simple Small AGS is an altered version of Apex Simple AGS to allow a "
"greater scaling down. The use of both thin thread (60) and thin needle (60) "
"are mandatory."
msgstr ""
"Apex Simple Small AGS é uma versão modificada da Apex Simple AGS que permite"
" reduzi-la mais. É obrigatório usar linha fina de peso 60 e agulha fina "
"número 60."

#. description of font in fonts/auberge_marif
#: inkstitch-fonts-metadata.py:32
msgid ""
"Auberge Marif is a script satin font. The glyphs cover most Western European"
" languages."
msgstr ""
"Auberge Marif é uma fonte satin script. Os glifos abrangem a maioria dos "
"idiomas da Europa Ocidental."

#. description of font in fonts/auberge_small
#: inkstitch-fonts-metadata.py:34
msgid ""
"Auberge Small is an altered version of Auberge Marif to allow a greater "
"scaling down. The use of both thin thread (60) and thin needle (60) are "
"mandatory."
msgstr ""
"Auberge Small é uma versão alterada de Auberge Marif para permitir uma "
"escala menor. O uso de linha fina (60) e agulha fina (60) é obrigatório."

#. description of font in fonts/aventurina
#: inkstitch-fonts-metadata.py:36
msgid ""
"Aventurina is a script satin font. The glyphs cover most Western European "
"languages."
msgstr ""
"Aventurina é uma fonte satin script. Os glifos abrangem a maioria dos "
"idiomas da Europa Ocidental."

#. description of font in fonts/barstitch_bold
#: inkstitch-fonts-metadata.py:38
msgid "Barstitch  Bold is a satin font."
msgstr "Barstitch Bold é uma fonte acetinada."

#. description of font in fonts/barstitch_cloudy
#: inkstitch-fonts-metadata.py:40
msgid ""
"This is a guided fill version of Barstitch fill. Each letter is used to clip"
" a group of guided fills and  then  a bean stitch contour is stitched. "
msgstr ""
"Esta é uma versão de preenchimento guiado do preenchimento em ponto barra. "
"Cada letra é usada para recortar um grupo de preenchimentos guiados e, em "
"seguida, um contorno em ponto feijão é costurado "

#. description of font in fonts/barstitch_crosses
#: inkstitch-fonts-metadata.py:42
msgid ""
"This is a cross stitch version of Barstitch fill. Each letter is used to "
"clip a group of cross  stitch  fills."
msgstr ""
"Esta é uma versão em ponto cruz do preenchimento Barstitch. Cada letra é "
"usada para recortar um grupo de preenchimentos em ponto cruz."

#. description of font in fonts/barstitch_mandala
#: inkstitch-fonts-metadata.py:44
msgid ""
"A large Mandala font. Redwork versions of the four mandalas  used to design "
"the font are stored in the $,<,>,^ glyphs"
msgstr ""
"Uma fonte grande de Mandala. Versões em Redwork das quatro mandalas usadas "
"para criar a fonte estão armazenadas nos glifos $,&lt;,&gt;,^"

#. description of font in fonts/barstitch_regular
#: inkstitch-fonts-metadata.py:46
msgid "Barstitch regular is a satin font. "
msgstr "Barstitch Regular é uma fonte de ponto cetim. "

#. description of font in fonts/barstitch_textured
#: inkstitch-fonts-metadata.py:48
msgid ""
"Barstitch textured is a highly textured font with the help of meander fills"
msgstr ""
"Barstitch Textured é uma fonte com muita textura produzida por "
"preenchimentos meandrados."

#. description of font in fonts/bathaus_FI
#: inkstitch-fonts-metadata.py:50
msgid "Bathaus FI is a satin font. Every satin has zigzag underlay."
msgstr ""
"Bathaus FI é uma fonte de ponto cetim. Todas as colunas de cetim têm "
"subcamada em zigue-zague."

#. description of font in fonts/bathaus_FI_Small
#: inkstitch-fonts-metadata.py:52
msgid ""
"Bathaus FI Small is an altered version of Bathaus FI, to allow a greater "
"scaling down. The use of both thin thread (60) and thin needle (60) are "
"mandatory."
msgstr ""
"Bathaus FI Small é uma versão modificada da Bathaus FI que permite reduzi-la"
" mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/bluenesia_satin
#: inkstitch-fonts-metadata.py:54
msgid ""
"A Syafrizal a.k.a. Khurasan jawn. 3.5mm satin at 100%, splits at higher "
"sizes."
msgstr ""
"Uma criação de Syafrizal, também conhecido como Khurasan. O cetim mede 3,5 "
"mm em escala de 100% e é dividido em tamanhos maiores."

#. description of font in fonts/braille
#: inkstitch-fonts-metadata.py:56
msgid ""
"Font for the visually impaired with Braille key combinations according to DT"
" 2024 INSEI specifications for French 6 dots Braille. It is also possible to"
" use Unicode Braille. In this case, it is convenient to use one of the web's"
" Braille translators to create a text in Braille unicode.\n"
msgstr ""
"Fonte para pessoas com deficiência visual, com combinações de teclas Braille"
" conforme as especificações DT 2024 do INSEI para o Braille francês de seis "
"pontos. Também é possível usar caracteres Braille Unicode. Nesse caso, pode-"
"se usar um tradutor de Braille disponível na internet para criar o texto em "
"Braille Unicode.\n"

#. description of font in fonts/caesarus_SC_FI
#: inkstitch-fonts-metadata.py:58
msgid ""
"Caesarus SC FI is a small capital satin font. It contains 107 glyphs "
"covering most Western European languages."
msgstr ""
"Caesarus SC FI é uma fonte pequena de letras maiúsculas em ponto cetim. Ela "
"contém 107 glifos e abrange a maioria dos idiomas da Europa Ocidental."

#. description of font in fonts/caffeine_KOR
#: inkstitch-fonts-metadata.py:60
msgid "Caffeine KOR is a satin font. Every satin has zigzag underlay."
msgstr ""
"Caffeine KOR é uma fonte de ponto cetim. Todas as colunas de cetim têm "
"subcamada em zigue-zague."

#. description of font in fonts/caffeine_tiny
#: inkstitch-fonts-metadata.py:62
msgid ""
"This font is an altered version  of Caffeine KOR, to allow a greater scaling"
" down. The use of both thin thread (60) and thin needle (60) is mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Caffeine KOR que permite reduzi-la "
"mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/califragilistic
#: inkstitch-fonts-metadata.py:64
msgid ""
"Califragilistic is a tricolor running stitch font that was constructed using"
" mandalas"
msgstr ""
"Califragilistic é uma fonte tricolor de ponto corrido construída com "
"mandalas."

#. description of font in fonts/cats
#: inkstitch-fonts-metadata.py:66
msgid "Cats is a silly font that makes use of satin random parameters."
msgstr ""
"Cats é uma fonte divertida que utiliza parâmetros aleatórios de ponto cetim."

#. description of font in fonts/cherryforinkstitch
#: inkstitch-fonts-metadata.py:68
msgid ""
"Cherry for inkstitch is a decorative satin column font. It contains 74 "
"glyphs."
msgstr ""
"Cherry for Ink/Stitch é uma fonte decorativa de colunas de cetim. Ela contém"
" 74 glifos."

#. description of font in fonts/cherryforkaalleen
#: inkstitch-fonts-metadata.py:70
msgid ""
"Cherry for Kaalleen is a large decorative font. It contains 36 glyphs "
"including the numbers and the 26 capitals  A-Z."
msgstr ""
"Cherry for Kaalleen é uma fonte decorativa grande. Ela contém 36 glifos, "
"incluindo os algarismos e as 26 letras maiúsculas de A a Z."

#. description of font in fonts/chicken_little
#: inkstitch-fonts-metadata.py:72
msgid ""
"Chicken Little  is a  playful decorative display font with loads of "
"personality. There is no common baseline, no common character size and no "
"common slope of the letters. Beyond 110% some satin columns will split."
msgstr ""
"Chicken Little é uma fonte decorativa e divertida, com muita personalidade. "
"As letras não compartilham a mesma linha de base, o mesmo tamanho nem a "
"mesma inclinação. Acima de 110% se dividirão algumas colunas de cetim."

#. description of font in fonts/chicken_little_small
#: inkstitch-fonts-metadata.py:74
msgid ""
"This font is an altered version  of Chicken Little KOR, to allow a greater "
"scaling down. The use of both  thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Chicken Little KOR que permite reduzi-"
"la mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/chicken_scratch
#: inkstitch-fonts-metadata.py:76
msgid "A handwritten font."
msgstr "Uma fonte manuscrita."

#. description of font in fonts/chopin
#: inkstitch-fonts-metadata.py:78
msgid "Chopin Script is a script satin font. Every satin has zigzag underlay."
msgstr ""
"Chopin Script é uma fonte cursiva em ponto cetim. Todas as colunas de cetim "
"têm subcamada em zigue-zague."

#. description of font in fonts/circular_3letters_monogram
#: inkstitch-fonts-metadata.py:80
msgid ""
"Enter 3 letters to get a circular three letters monogram. You can add a frame, by adding one of the following :(){,[];.<>\n"
"For instance enter {ABC.\n"
"Please use exactly 3 letters, no less, no more, or you could get some unexpected result."
msgstr ""
"Digite 3 letras para obter um monograma circular de três letras. Você pode adicionar uma moldura, adicionando um dos seguintes símbolos :(){,[];.<>\n"
"Por exemplo, digite {ABC.\n"
"Use exatamente 3 letras, nem mais, nem menos, ou poderá obter um resultado inesperado."

#. description of font in fonts/cogs_KOR
#: inkstitch-fonts-metadata.py:82
msgid "Cogs KOR is a Steampunk  satin font."
msgstr "Cogs KOR é um tipo de fonte Steampunk acetinada."

#. description of font in fonts/colorful
#: inkstitch-fonts-metadata.py:84
msgid "Colorful is a tartan fill font."
msgstr "Colorful é uma fonte com preenchimento tartã."

#. description of font in fonts/computer
#: inkstitch-fonts-metadata.py:86
msgid "satin font"
msgstr "fonte de ponto cetim"

#. description of font in fonts/computer_small
#: inkstitch-fonts-metadata.py:88
msgid ""
"Small satin font: the use of both thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Fonte pequena em ponto cetim: é obrigatório usar linha fina de peso 60 e "
"agulha fina número 60."

#. description of font in fonts/cooper_marif
#: inkstitch-fonts-metadata.py:90
msgid "CooperMarif is a large and airy font."
msgstr "CooperMarif é uma fonte grande e arejada."

#. description of font in fonts/cyrillic
#: inkstitch-fonts-metadata.py:92
msgid "Cyrillic and latin satin font."
msgstr "Fonte de ponto cetim com caracteres cirílicos e latinos."

#. description of font in fonts/decadent_flowers_monogram
#: inkstitch-fonts-metadata.py:94
msgid ""
"Each Decadent Flowers Monogram lettter  is composed of an optional knockdown"
" fill (for high pile fabric embroidery)  and redwork flowers  with a "
"negative space letter monogram"
msgstr ""
"Cada letra da fonte Decadent Flowers Monogram é composta por um "
"preenchimento de rebaixamento opcional, próprio para bordar tecidos "
"felpudos, e flores em redwork formando a letra do monograma em espaço "
"negativo."

#. description of font in fonts/dejavufont
#: inkstitch-fonts-metadata.py:96
msgid ""
"DejaVu Serif Condensed is a satin font. Every satin has center-walk "
"underlay."
msgstr ""
"DejaVu Serif Condensed é uma fonte de ponto cetim. Todas as colunas de cetim"
" têm subcamada central."

#. description of font in fonts/digory_doodles_bean
#: inkstitch-fonts-metadata.py:98
msgid "All letters of Digory Doodles Bean mix satin and bean stitch."
msgstr ""
"Todas as letras da Digory Doodles Bean combinam ponto cetim e ponto feijão."

#. description of font in fonts/dinomouse72
#: inkstitch-fonts-metadata.py:100
msgid "A Font Grove jawn. Satin width is 2.5mm at 18mm capitals"
msgstr ""
"Uma joia da Fonte Grove. A largura do cetim é de 2,5 mm com maiúsculas de 18"
" mm"

#. description of font in fonts/egyptian
#. description of font in fonts/heavenly
#. description of font in fonts/noble
#: inkstitch-fonts-metadata.py:102 inkstitch-fonts-metadata.py:146
#: inkstitch-fonts-metadata.py:226
msgid "small cross stitch font"
msgstr "fonte pequena de ponto cruz"

#. description of font in fonts/egyptian_small
#: inkstitch-fonts-metadata.py:104
msgid ""
"This font is an altered version of Egyptian, to allow a greater scaling "
"down. The use of both thin thread (60) and thin needle (60) is mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Egyptian que permite reduzi-la mais. É"
" obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/ellenika
#: inkstitch-fonts-metadata.py:106
msgid "Clara Bold Greek subset with punctuation and symbol support."
msgstr "Subconjunto grego da Clara Bold, com suporte a pontuação e símbolos."

#. description of font in fonts/eloquent
#: inkstitch-fonts-metadata.py:108
msgid "small cursive crosstitch font"
msgstr "fonte cursiva pequena de ponto cruz"

#. description of font in fonts/eloquent_small
#: inkstitch-fonts-metadata.py:110
msgid ""
"This font is an altered version of Eloquent, to allow a greater scaling "
"down. The use of both thin thread (60) and thin needle (60) is mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Eloquent que permite reduzi-la mais. É"
" obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/emilio_20
#: inkstitch-fonts-metadata.py:112
msgid ""
"Emilio 20 contains only capitals and numbers. Every satin has zigzag "
"underlay."
msgstr ""
"Emilio 20 contém apenas letras maiúsculas e algarismos. Todas as colunas de "
"cetim têm subcamada em zigue-zague."

#. description of font in fonts/emilio_20_applique
#: inkstitch-fonts-metadata.py:114
msgid ""
"Emilio 20 Applique is an Applique font. This font is an altered version "
"(larger satin columns) of Emilio_20 while Emilio_20_Bold is  "
"Emilio_20_applique without the applique."
msgstr ""
"Emilio 20 Applique é uma fonte para aplique. Ela é uma versão modificada da "
"Emilio_20, com colunas de cetim maiores; a Emilio_20_Bold, por sua vez, "
"corresponde à Emilio_20_Applique sem o aplique."

#. description of font in fonts/emilio_20_bold
#: inkstitch-fonts-metadata.py:116
msgid "Emilio_20_Bold is an altered version of Emilio_20."
msgstr "Emilio_20_Bold é uma versão modificada da Emilio_20."

#. description of font in fonts/emilio_20_simple
#: inkstitch-fonts-metadata.py:118
msgid ""
"Emilio is a font with capital only and numbers. Every satin has zigzag "
"underlay."
msgstr ""
"Emilio é uma fonte que contém somente letras maiúsculas e algarismos. Todas "
"as colunas de cetim têm subcamada em zigue-zague."

#. description of font in fonts/emilio_20_simple_small
#: inkstitch-fonts-metadata.py:120
msgid ""
"This font is an altered version  of Emilio 20 simple, to allow a greater "
"scaling down. The use of both  thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Emilio 20 Simple que permite reduzi-la"
" mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/emilio_20_tartan
#: inkstitch-fonts-metadata.py:122
msgid "Emilio 20 Tartan uses tartan fill for a colorful font."
msgstr ""
"Emilio 20 Tartan usa preenchimento tartã para produzir uma fonte colorida."

#. description of font in fonts/emilio_20_tricolore
#: inkstitch-fonts-metadata.py:124
msgid ""
"Emilio 20 tricolore is a large tricolor fill stitches and satin columns "
"font. It contains 36 glyphs including the numbers and the 26 capitals  A-Z."
msgstr ""
"Emilio 20 Tricolore é uma fonte tricolor grande que combina pontos de "
"preenchimento e colunas de cetim. Ela contém 36 glifos, incluindo os "
"algarismos e as 26 letras maiúsculas de A a Z."

#. description of font in fonts/excalibur_KOR
#: inkstitch-fonts-metadata.py:126
msgid ""
"Excalibur KOR is a small satin column manuscript font. It contains 144 "
"glyphs, covering most western European languages needs."
msgstr ""
"Excalibur KOR é uma fonte manuscrita pequena formada por colunas de cetim. "
"Ela contém 144 glifos e atende à maioria dos idiomas da Europa Ocidental."

#. description of font in fonts/excalibur_small
#: inkstitch-fonts-metadata.py:128
msgid ""
"This font is an altered version  of Excalibur KOR, to allow a greater "
"scaling down. The use of both  thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Esta fonte é uma versão alterada da Excalibur KOR, para permitir uma escala "
"menor. O uso de linha fina (60) e agulha fina (60) é obrigatório."

#. description of font in fonts/flowery_crosses
#: inkstitch-fonts-metadata.py:130
msgid "Very large cross stitch font. "
msgstr "Fonte muito grande de ponto cruz. "

#. description of font in fonts/flowery_multicolor
#: inkstitch-fonts-metadata.py:132
msgid "Very large multicolor cross stitch font. "
msgstr "Fonte multicolorida muito grande de ponto cruz. "

#. description of font in fonts/fold_inkstitch
#: inkstitch-fonts-metadata.py:134
msgid ""
"Fold Ink/Stitch is a large triple and quintuple running stitches capital "
"font. It contains 40 glyphs including all numbers and the 26 capitals  A-Z."
msgstr ""
"Fold Ink/Stitch é uma fonte grande de letras maiúsculas feita com pontos "
"corridos triplos e quíntuplos. Ela contém 40 glifos, incluindo todos os "
"algarismos e as 26 letras maiúsculas de A a Z."

#. description of font in fonts/geneva_rounded
#: inkstitch-fonts-metadata.py:136
msgid "Geneva Simple Sans Rounded is a satin font."
msgstr "Geneva Simple Sans Rounded é uma fonte de ponto cetim."

#. description of font in fonts/geneva_simple
#: inkstitch-fonts-metadata.py:138
msgid "Geneva Simple Sans is a satin font."
msgstr "Geneva Simple Sans é uma fonte de ponto cetim."

#. description of font in fonts/gingo200
#: inkstitch-fonts-metadata.py:140
msgid "Gingo 200 is playful satin font with 158 glyphs."
msgstr "Gingo 200 é uma fonte divertida de ponto cetim com 158 glifos."

#. description of font in fonts/glacial_tiny
#: inkstitch-fonts-metadata.py:142
msgid ""
"Glacial is a very tiny font. Thin thread (60 wt ) and thin needle (8/60) are"
" mandatory. The glyphs cover many European languages."
msgstr ""
"Glacial é uma fonte muito pequena. É obrigatório usar linha fina de peso 60 "
"e agulha fina 8/60. Os glifos abrangem muitos idiomas europeus."

#. description of font in fonts/handkerchief
#: inkstitch-fonts-metadata.py:144
msgid ""
"Cross stitch font. Initially intended to embroider handkerchiefs corners."
msgstr ""
"Fonte de ponto cruz criada originalmente para bordar os cantos de lenços."

#. description of font in fonts/heavenly_small
#: inkstitch-fonts-metadata.py:148
msgid ""
"This font is an altered version of Heavenly, to allow a greater scaling "
"down. The use of both thin thread (60) and thin needle (60) is mandatory."
msgstr ""
"Esta fonte é uma versão modificada da Heavenly que permite reduzi-la mais. É"
" obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/hebrew_font_large
#: inkstitch-fonts-metadata.py:150
msgid "Large size Hebrew satin font"
msgstr "Fonte hebraica de cetim de tamanho grande"

#. description of font in fonts/hebrew_font_medium
#: inkstitch-fonts-metadata.py:152
msgid "Medium size hebrew satin font"
msgstr "Fonte hebraica de tamanho médio em ponto cetim"

#. description of font in fonts/hebrew_simple_rounded
#: inkstitch-fonts-metadata.py:154
msgid "A simple rounded hebrew font"
msgstr "Uma fonte hebraica simples e arredondada"

#. description of font in fonts/hebrew_simple_rounded_small
#: inkstitch-fonts-metadata.py:156
msgid ""
"A simple rounded hebrew font, small version to be embroidered with 60wt "
"thread and 60 needle"
msgstr ""
"Versão pequena de uma fonte hebraica simples e arredondada, destinada ao "
"bordado com linha de peso 60 e agulha número 60"

#. description of font in fonts/honoka
#: inkstitch-fonts-metadata.py:158
msgid ""
"コルの書きこも is a satin column japanese script font. It contains all hiragana, "
"katakana and punctuation glyphs plus 80 kanjis."
msgstr ""
"コルの書きこも é uma fonte de escrita japonesa formada por colunas de cetim. Ela "
"contém todos os glifos hiragana, katakana e de pontuação, além de 80 kanjis."

#. description of font in fonts/infinipicto
#: inkstitch-fonts-metadata.py:160
msgid ""
"InfiniPicto is a fun font containing only the 26 A-Z glyph. Each letter is a"
" pictogram of an object whose name begins with that very letter..... in "
"French"
msgstr ""
"InfiniPicto é uma fonte divertida que contém somente os 26 glifos de A a Z. "
"Cada letra é o pictograma de um objeto cujo nome em francês começa com essa "
"mesma letra."

#. description of font in fonts/initials_XL
#: inkstitch-fonts-metadata.py:162
#, python-brace-format
msgid ""
"Initials XL is a very large satin stitch Capital font. It contains the 37 "
"glyphs :ampersand, A-Z and 0-9. In addition the ten glyphs (){}[],;.: are "
"used to store frames. Type any letter followed by any frame (e.g. A( or B; )"
"  to obtain a framed Capital or Number. Warning: for a few large letters you"
" will need to manually enlarge the frame."
msgstr ""
"Initials XL é uma fonte muito grande de letras maiúsculas em ponto cetim. "
"Ela contém 37 glifos: o e comercial, A a Z e 0 a 9. Além disso, os dez "
"glifos (){}[],;.: armazenam molduras. Digite uma letra seguida de uma "
"moldura, como A( ou B;, para obter uma letra maiúscula ou um algarismo "
"emoldurado. Aviso: para algumas letras grandes, será necessário ampliar "
"manualmente a moldura."

#. description of font in fonts/initials_medium
#: inkstitch-fonts-metadata.py:164
#, python-brace-format
msgid ""
"Initials Medium is a satin stitch Capital font. It contains the 37 glyphs "
":ampersand, A-Z and 0-9. In addition the ten glyphs (){}[],;.: are used to "
"store frames. Type any letter followed by any frame (e.g. A( or B; or 7, ) "
"to obtain a framed Capital or Number. Some manual arranging of the frame "
"around the letter may be required."
msgstr ""
"Initials Medium é uma fonte de letras maiúsculas em ponto cetim. Ela contém "
"37 glifos: o e comercial, A a Z e 0 a 9. Além disso, os dez glifos "
"(){}[],;.: armazenam molduras. Digite uma letra seguida de uma moldura, como"
" A(, B; ou 7,, para obter uma letra maiúscula ou um algarismo emoldurado. "
"Talvez seja necessário ajustar manualmente a moldura ao redor da letra."

#. description of font in fonts/inkstitch_masego
#: inkstitch-fonts-metadata.py:166
msgid "Masego is a display san-serif typeface."
msgstr "Masego é uma fonte sem serifa para títulos e destaques."

#. description of font in fonts/invercelia
#: inkstitch-fonts-metadata.py:168
msgid ""
"Invercelia is a modern two letters monogram font. Enter two letters to get a simple monogram.  Add an ')' at the end and the monogram is framed with a circle (for instance 'AC)'), add an '(' to start (for instance '(AC)' and your monogram is ready for applique, or  try something like '!AC)' to replace the appliqué by knockdown stitches.\n"
"\n"
"Please use exactly two letters,  if you use more, only the first and the last letters will be rendered."
msgstr ""
"Invercelia é uma fonte moderna para monogramas de duas letras. Digite duas letras para obter um monograma simples. Acrescente ')' no final para colocar o monograma dentro de um círculo, por exemplo 'AC)'. Acrescente '(' no início, por exemplo '(AC)', para preparar o monograma para aplique. Você também pode usar algo como '!AC)' para substituir o aplique por pontos de rebaixamento.\n"
"\n"
"Use exatamente duas letras. Se você digitar mais, somente a primeira e a última serão renderizadas."

#. description of font in fonts/jacquard_12
#. description of font in fonts/jersey_15
#: inkstitch-fonts-metadata.py:170 inkstitch-fonts-metadata.py:174
msgid "cross stitch font"
msgstr "fonte de ponto cruz"

#. description of font in fonts/jaquarda_bastarda_9
#: inkstitch-fonts-metadata.py:172
msgid "small cross stitch font derived from a victorian needlepoint alphabet"
msgstr ""
"fonte pequena de ponto cruz derivada de um alfabeto vitoriano para bordado à"
" mão"

#. description of font in fonts/kum_tsoan_AGS
#: inkstitch-fonts-metadata.py:176
msgid ""
" Kum Tsoan AGS is a large applique font. It contains 43 glyphs including all"
" numbers and the 26 capitals  A-Z."
msgstr ""
" Kum Tsoan AGS é uma fonte grande para aplique. Ela contém 43 glifos, "
"incluindo todos os algarismos e as 26 letras maiúsculas de A a Z."

#. description of font in fonts/kum_tsoan_relief
#: inkstitch-fonts-metadata.py:178
msgid ""
"Kum Tsoan Relief is an altered version of Kum Tsoan AGS for embossed "
"letters."
msgstr ""
"Kum Tsoan Relief é uma versão modificada da Kum Tsoan AGS destinada a letras"
" em relevo."

#. description of font in fonts/kum_tsoan_tartan
#: inkstitch-fonts-metadata.py:180
msgid ""
"Kum Tsoan Tartan is a tartan fill font. It contains 43 glyphs including all "
"numbers and the 26 capitals."
msgstr ""
"Kum Tsoan Tartan é uma fonte com preenchimento tartã. Ela contém 43 glifos, "
"incluindo todos os algarismos e as 26 letras maiúsculas."

#. description of font in fonts/ladies_present
#: inkstitch-fonts-metadata.py:182
msgid "A  rectangular crosses font"
msgstr "Uma fonte de cruzes retangulares"

#. description of font in fonts/learning_curve
#: inkstitch-fonts-metadata.py:184
msgid "Learning curve is a small running stitch script font."
msgstr "Learning Curve é uma fonte cursiva pequena de ponto corrido."

#. description of font in fonts/magic_crosses
#: inkstitch-fonts-metadata.py:186
msgid "Cross stitch font. "
msgstr "Fonte de ponto cruz. "

#. description of font in fonts/magnolia_KOR
#: inkstitch-fonts-metadata.py:188
msgid "Magnolia KOR is a script satin font."
msgstr "Magnolia KOR é uma fonte cursiva de ponto cetim."

#. description of font in fonts/magnolia_bicolor
#: inkstitch-fonts-metadata.py:190
msgid "Magnolia bicolor is a  larger  bicolor variation of Magnolia font."
msgstr "Magnolia Bicolor é uma variação bicolor maior da fonte Magnolia."

#. description of font in fonts/magnolia_small
#: inkstitch-fonts-metadata.py:192
msgid ""
"Magnolia Small is an altered version  of Magnolia KOR, to allow a greater "
"scaling down. The use of both  thin thread (60) and thin needle (60) is "
"mandatory."
msgstr ""
"Magnolia Small é uma versão modificada da Magnolia KOR que permite reduzi-la"
" mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/magnolia_tamed
#: inkstitch-fonts-metadata.py:194
msgid "This is a less wild bicolor variation of Magnolia font"
msgstr "Esta é uma variação bicolor mais discreta da fonte Magnolia."

#. description of font in fonts/mai_en_fleur
#: inkstitch-fonts-metadata.py:196
msgid "Mai en Fleur AGS is a monogram font."
msgstr "Mai en Fleur AGS é uma fonte para monogramas."

#. description of font in fonts/malika
#: inkstitch-fonts-metadata.py:198
msgid ""
"Malika is an arabic satin font.   Non  mandatory diacritics should not be  "
"typed within the text but   rather separately  and then manually  moved  to "
"the correct position. The three sets of brackets host embellishments if you "
"want to add an extra ornamental touch."
msgstr ""
"Malika é uma fonte árabe de ponto cetim. Os diacríticos opcionais não devem "
"ser digitados dentro do texto; digite-os separadamente e depois mova-os "
"manualmente para a posição correta. Os três pares de colchetes contêm "
"enfeites que podem acrescentar um toque ornamental."

#. description of font in fonts/mam_script
#: inkstitch-fonts-metadata.py:200
msgid "MAM Script is a script satin font. Every satin has zigzag underlay."
msgstr ""
"MAM Script é uma fonte cursiva de ponto cetim. Todas as colunas de cetim têm"
" subcamada em zigue-zague."

#. description of font in fonts/manga_impact
#: inkstitch-fonts-metadata.py:202
msgid "Manga Impact is a manga like satin font."
msgstr "Manga Impact é uma fonte de ponto cetim inspirada em mangás."

#. description of font in fonts/marifenda
#: inkstitch-fonts-metadata.py:204
msgid "Medium size font "
msgstr "Fonte de tamanho médio "

#. description of font in fonts/medium_font
#: inkstitch-fonts-metadata.py:206
msgid ""
"Ink/Stitch Medium Font is a basic satin font suited for medium-sized "
"characters. Every satin has contour underlay."
msgstr ""
"Ink/Stitch Medium Font é uma fonte básica de ponto cetim adequada a "
"caracteres de tamanho médio. Todas as colunas de cetim têm subcamada de "
"contorno."

#. description of font in fonts/milli_marif_bold
#: inkstitch-fonts-metadata.py:208
msgid "Millimarif-bold20 is a  bold satin font."
msgstr "Millimarif-bold20 é uma fonte em negrito de ponto cetim."

#. description of font in fonts/mimosa_large
#: inkstitch-fonts-metadata.py:210
msgid "Mimosa Large is a satin font that looks like a dotty font.   "
msgstr "Mimosa Large é uma fonte de ponto cetim com aparência pontilhada.   "

#. description of font in fonts/mimosa_medium
#: inkstitch-fonts-metadata.py:212
msgid "Mimosa Medium is a satin font that looks dotty."
msgstr "Mimosa Medium é uma fonte de ponto cetim com aparência pontilhada."

#. description of font in fonts/monicha
#: inkstitch-fonts-metadata.py:214
msgid ""
"Monicha is a script satin font. In addition to the glyphs covering most "
"Western European languages it contains alternate ornemental letters with "
"swashes. These ornemental letters should be used with caution to avoid "
"overlays. In particular do not use two ornemental letters in a row. Please "
"consult the documentation for information on how to access the ornemental "
"letters."
msgstr ""
"Monicha é uma fonte cursiva de ponto cetim. Além dos glifos que abrangem a "
"maioria dos idiomas da Europa Ocidental, ela contém letras ornamentais "
"alternativas com floreios. Use essas letras com cuidado para evitar "
"sobreposições; em especial, não use duas letras ornamentais seguidas. "
"Consulte a documentação para saber como acessar essas letras."

#. description of font in fonts/montecarlo
#: inkstitch-fonts-metadata.py:216
msgid ""
"Montecarlo is a script satin font with lots of alternates. It also contains"
"  swoops , swashes and  more, see the documentation  for details."
msgstr ""
"Montecarlo é uma fonte cursiva de ponto cetim com muitas formas "
"alternativas. Ela também contém curvas, floreios e outros ornamentos; "
"consulte a documentação para obter detalhes."

#. description of font in fonts/nautical
#: inkstitch-fonts-metadata.py:218
msgid "Cross Stitch Nautical Flag Alphabet"
msgstr "Alfabeto de bandeiras náuticas em ponto cruz"

#. description of font in fonts/neon
#: inkstitch-fonts-metadata.py:220
msgid "Satin font. Each letter or accent is a single satin."
msgstr ""
"Fonte de ponto cetim. Cada letra ou acento é formado por uma única coluna de"
" cetim."

#. description of font in fonts/neon_blinking
#: inkstitch-fonts-metadata.py:222
msgid "Bean stitch font."
msgstr "Fonte de ponto feijão."

#. description of font in fonts/nick_ainley
#: inkstitch-fonts-metadata.py:224
msgid ""
"NickAinley is a tiny bean alphabet based on a 24pt Seniors Studio jawn."
msgstr ""
"NickAinley é um alfabeto minúsculo em ponto feijão baseado em uma criação de"
" 24 pontos do Seniors Studio."

#. description of font in fonts/ondulamarif_Medium
#: inkstitch-fonts-metadata.py:228
msgid ""
"Ondulamarif M is an altered version  of Ondulamarif XL. The altered "
"embroidery parameters of this font allow for a smaller font."
msgstr ""
"Ondulamarif M é uma versão modificada da Ondulamarif XL. Os parâmetros de "
"bordado foram ajustados para permitir uma fonte menor."

#. description of font in fonts/ondulamarif_S
#: inkstitch-fonts-metadata.py:230
msgid ""
"Ondulamarif S is an altered version  of Ondulamarif XL, to allow a greater "
"scaling down."
msgstr ""
"Ondulamarif S é uma versão modificada da Ondulamarif XL que permite reduzi-"
"la mais."

#. description of font in fonts/ondulamarif_XL
#: inkstitch-fonts-metadata.py:232
msgid ""
"Ondulamarif XL is a ripple stitch font, use it as large as you can, but do "
"not reduce it."
msgstr ""
"Ondulamarif XL é uma fonte de ponto ondulado. Use-a no maior tamanho "
"possível e não a reduza."

#. description of font in fonts/pacificlo
#: inkstitch-fonts-metadata.py:234
msgid ""
"Pacificlo is a small satin column manuscript font. It contains 120 glyphs, "
"covering most Western European Languages needs. "
msgstr ""
"Pacificlo é uma fonte manuscrita pequena formada por colunas de cetim. Ela "
"contém 120 glifos e atende à maioria dos idiomas da Europa Ocidental. "

#. description of font in fonts/pacificlo_tiny
#: inkstitch-fonts-metadata.py:236
msgid ""
"Pacificlo tiny is an altered version  of Pacificlo, to allow a greater "
"scaling down. Both thin thread (60) and thin needle (60) are mandatory."
msgstr ""
"Pacificlo Tiny é uma versão modificada da Pacificlo que permite reduzi-la "
"mais. É obrigatório usar linha fina de peso 60 e agulha fina número 60."

#. description of font in fonts/paquerette
#: inkstitch-fonts-metadata.py:238
msgid ""
"Paquerette font is created with manual sitch. Do not change the size or very"
" little."
msgstr ""
"A fonte Paquerette é criada com pontos manuais. Não altere seu tamanho ou "
"altere-o muito pouco."

#. description of font in fonts/perspective_tricolore_KOR
#: inkstitch-fonts-metadata.py:240
msgid ""
"Perspective tricolore KOR is a shaded tricolor font with capital letters "
"only, numbers and ponctuation."
msgstr ""
"Perspective Tricolore KOR é uma fonte tricolor sombreada que contém somente "
"letras maiúsculas, algarismos e pontuação."

#. description of font in fonts/pisankris
#: inkstitch-fonts-metadata.py:242
msgid "Pisankris is a satin font. Every satin has zigzag underlay."
msgstr ""
"Pisankris é uma fonte de ponto cetim. Todas as colunas de cetim têm "
"subcamada em zigue-zague."

#. description of font in fonts/pixel10
#: inkstitch-fonts-metadata.py:244
msgid "Pixel 10 is a satin pixel font."
msgstr "Pixel 10 é uma fonte de pixels em ponto cetim."

#. description of font in fonts/precious
#: inkstitch-fonts-metadata.py:246
msgid "Precious is a decorative satin column round cursive font."
msgstr ""
"Precious é uma fonte cursiva, arredondada e decorativa formada por colunas "
"de cetim."

#. description of font in fonts/priscilla
#: inkstitch-fonts-metadata.py:248
msgid "Large bicolor cross stitch font"
msgstr "Fonte bicolor grande de ponto cruz"

#. description of font in fonts/roaring_twenties_KOR
#: inkstitch-fonts-metadata.py:250
msgid "Roaring Twenties KOR is a mix of satin and bean stitches."
msgstr "Roaring Twenties KOR combina pontos cetim e pontos feijão."

#. description of font in fonts/roaring_twenties_KOR_small
#: inkstitch-fonts-metadata.py:252
msgid ""
"Roaring Twenties KOR Small is an altered version  of Roaring Twenties KOR, "
"to allow a greater scaling down. The use of both thin thread (60) and thin "
"needle (60) is mandatory."
msgstr ""
"Roaring Twenties KOR Small é uma versão modificada da Roaring Twenties KOR "
"que permite reduzi-la mais. É obrigatório usar linha fina de peso 60 e "
"agulha fina número 60."

#. description of font in fonts/roman_ags
#: inkstitch-fonts-metadata.py:254
msgid ""
"Roman AGS is based on Latin Modern Roman 10 Bold italic. Every satin has "
"zigzag underlay."
msgstr ""
"Roman AGS é baseada na Latin Modern Roman 10 Bold Italic. Todas as colunas "
"de cetim têm subcamada em zigue-zague."

#. description of font in fonts/roman_ags_bicolor
#: inkstitch-fonts-metadata.py:256
msgid ""
"Roman bicolor AGS is an altered version of Roman AGS. Capital letters are "
"bicolor."
msgstr ""
"Roman Bicolor AGS é uma versão modificada da Roman AGS. As letras maiúsculas"
" são bicolores."

#. description of font in fonts/sacramarif
#: inkstitch-fonts-metadata.py:258
msgid "Sacramarif is a very small running stitch font based on Sacramento."
msgstr ""
"Sacramarif é uma fonte muito pequena de ponto corrido baseada na Sacramento."

#. description of font in fonts/small_font
#: inkstitch-fonts-metadata.py:260
msgid "Ink/Stitch Small Font is suited for small characters."
msgstr "Ink/Stitch Small Font é adequada a caracteres pequenos."

#. description of font in fonts/stebor_AGS
#: inkstitch-fonts-metadata.py:262
msgid "Stebor AGS is a script satin font. Every satin has zigzag underlay."
msgstr ""
"Stebor AGS é uma fonte cursiva de ponto cetim. Todas as colunas de cetim têm"
" subcamada em zigue-zague."

#. description of font in fonts/sunset
#: inkstitch-fonts-metadata.py:264
msgid "3 colors satin column font"
msgstr "Fonte de colunas de cetim em três cores"

#. description of font in fonts/tieralphabet
#: inkstitch-fonts-metadata.py:266
msgid ""
"cross stitch font, each letter includes an animal with german name starting "
