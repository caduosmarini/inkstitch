#: lib/commands.py:429
msgid "command marker"
msgstr "comando do marcador"

#: lib/commands.py:484
msgid "Please select a layer to include layer commands."
msgstr "Selecione uma camada para incluir comandos de camada."

#: lib/elements/clone.py:29
msgid "Clone Object"
msgstr "Clonar Objeto"

#: lib/elements/clone.py:30
msgid ""
"There are one or more clone objects in this document.  Ink/Stitch can work "
"with clones, but you are limited to set a very few parameters. "
msgstr ""
"Há um ou mais clones neste documento. O Ink/Stitch trabalha com clones, mas "
"permite configurar poucos parâmetros. "

#: lib/elements/clone.py:33
msgid ""
"If you want to convert the clone into a real element, follow these steps:"
msgstr "Para converter o clone em um elemento real, siga estas etapas:"

#: lib/elements/clone.py:34
msgid "* Select the clone"
msgstr "* Selecione o clone"

#: lib/elements/clone.py:35
msgid "* Run: Extensions > Ink/Stitch > Edit > Unlink Clone"
msgstr "* Execute: Extensões > Ink/Stitch > Editar > Desvincular clone"

#: lib/elements/clone.py:41 lib/elements/clone.py:47
#: inx/inkstitch_select_elements.inx:74 inx/inkstitch_select_elements.inx:75
msgid "Clone"
msgstr "Clonar"

#: lib/elements/clone.py:53
msgid "Custom fill angle"
msgstr "Ângulo de preenchimento customizado"

#: lib/elements/clone.py:54
msgid "This setting will apply a custom fill angle for the clone."
msgstr ""
"Esta configuração vai aplicar um ângulo de preenchimento customizado para o "
"clone."

#: lib/elements/clone.py:63
msgid "Flip angle"
msgstr "inverter ângulo"

#: lib/elements/clone.py:65
msgid "Flip automatically calculated angle if it appears to be wrong."
msgstr "Inverter o ângulo calculado automaticamente se ele parecer incorreto."

#: lib/elements/element.py:307 lib/gui/preferences.py:61
#: lib/gui/preferences.py:152
msgid "Minimum stitch length"
msgstr "Comprimento mínimo do ponto"

#: lib/elements/element.py:308
msgid ""
"Overwrite global minimum stitch length setting. Shorter stitches than that "
"will be removed."
msgstr ""
"Substituir a configuração global de comprimento mínimo do ponto. Pontos "
"menores serão removidos."

#: lib/elements/element.py:319 lib/gui/preferences.py:42
msgid "Minimum jump stitch length"
msgstr "Comprimento mínimo do ponto de salto"

#: lib/elements/element.py:320
msgid ""
"Overwrite global minimum jump stitch length setting. Shorter distances to "
"the next object will have no lock stitches."
msgstr ""
"Substituir o comprimento mínimo global do ponto de salto. Distâncias menores"
" até o próximo objeto não terão pontos de arremate."

#: lib/elements/element.py:331
msgid "Allow lock stitches"
msgstr "Permitir pontos de arremate"

#: lib/elements/element.py:332
msgid ""
"Tie thread at the beginning and/or end of this object. Manual stitch will "
"only add lock stitches if force lock stitched is checked."
msgstr ""
"Prender a linha no início e/ou no fim deste objeto. O ponto manual somente "
"adicionará arremates se Forçar pontos de arremate estiver marcado."

#. options to allow lock stitch before and after objects
#: lib/elements/element.py:337
msgid "Both"
msgstr "Ambos"

#: lib/elements/element.py:337
msgid "Before"
msgstr "Inicial"

#: lib/elements/element.py:337
msgid "After"
msgstr "Final"

#: lib/elements/element.py:337
msgid "Neither"
msgstr "Nenhum"

#: lib/elements/element.py:346
#: inx/inkstitch_lettering_force_lock_stitches.inx:3
msgid "Force lock stitches"
msgstr "Forçar pontos de arremate"

#: lib/elements/element.py:347
msgid ""
"Sew lock stitches after sewing this element, even if the distance to the "
"next object is shorter than defined by the minimum jump stitch length value "
"in the Ink/Stitch preferences."
msgstr ""
"Bordar pontos de arremate após este elemento, mesmo que a distância até o "
"próximo objeto seja menor que o comprimento mínimo do ponto de salto "
"definido nas preferências."

#: lib/elements/element.py:359
msgid "Tack stitch"
msgstr "ponto de fixação"

#: lib/elements/element.py:360
msgid "Tack down stitch type"
msgstr "Tipo de ponto de fixação"

#: lib/elements/element.py:370 lib/elements/element.py:416
msgid "Custom path"
msgstr "Caminho customizado"

#: lib/elements/element.py:371
msgid ""
"Enter a custom path. For svg paths The last node will not be embroidered, "
"but represents the first stitch of the element."
msgstr ""
"Digite um caminho personalizado. Em caminhos SVG, o último nó não será "
"bordado, mas representará o primeiro ponto do elemento."

#: lib/elements/element.py:381 lib/elements/element.py:393
msgid "Scale tack stitch"
msgstr "Redimensionar ponto de fixação"

#: lib/elements/element.py:382
msgid "Set stitch length. A 1 in a custom path equals this values."
msgstr ""
"Defina o comprimento do ponto. O valor 1 em um caminho personalizado "
"equivale a este valor."

#: lib/elements/element.py:394
msgid "Scale tack stitch by this percentage."
msgstr "Redimensionar o ponto de fixação por este percentual."

#: lib/elements/element.py:405
msgid "Lock stitch"
msgstr "ponto de arremate"

#: lib/elements/element.py:406
msgid "Lock stitch type"
msgstr "Tipo de ponto de arremate"

#: lib/elements/element.py:417
msgid ""
"Enter a custom path. For svg paths the first node will not be embroidered, "
"but represents the last stitch of the element."
msgstr ""
"Digite um caminho personalizado. Em caminhos SVG, o primeiro nó não será "
"bordado, mas representará o último ponto do elemento."

#: lib/elements/element.py:427 lib/elements/element.py:439
msgid "Scale lock stitch"
msgstr "Redimensionar ponto de arremate"

#: lib/elements/element.py:428
msgid "Set length of lock stitches (mm)."
msgstr "Definir o comprimento dos pontos de arremate (mm)."

#: lib/elements/element.py:440
msgid "Scale lock stitch by this percentage."
msgstr "Redimensionar o ponto de arremate por este percentual."

#: lib/elements/element.py:456
msgid "Trim After"
msgstr "Cortar Depois"

#: lib/elements/element.py:457
msgid "Add a TRIM command after stitching this object."
msgstr "Adicionar o comando de corte após bordar este objeto."

#: lib/elements/element.py:466
msgid "Stop After"
msgstr "Parar Depois"

#: lib/elements/element.py:467
msgid "Add a STOP command after stitching this object."
msgstr "Adicionar um comando de Parar após bordar este objeto."

#: lib/elements/element.py:815
msgid ""
"Please run Extensions > Ink/Stitch > Troubleshoot > Troubleshoot objects. "
"This will show you the exact location of the problem."
msgstr ""
"Execute Extensões > Ink/Stitch > Solução de problemas > Solucionar problemas"
" dos objetos. Isso mostrará a localização exata do problema."

#: lib/elements/empty_d_object.py:13
msgid "EmptyD"
msgstr "EmptyD"

#: lib/elements/empty_d_object.py:14
msgid ""
"There is an invalid object in the document without geometry information."
msgstr "Há no documento um objeto inválido sem informações de geometria."

#: lib/elements/empty_d_object.py:16
msgid "* Run Extensions > Ink/Stitch > Troubleshoot > Cleanup Document..."
msgstr ""
"* Execute Extensões > Ink/Stitch > Solução de problemas > Limpar "
"documento..."

#: lib/elements/empty_d_object.py:22
msgid "Empty Path"
msgstr "caminho vazio"

#: lib/elements/fill_stitch.py:37
msgid "Small Fill"
msgstr "Pequeno preenchimento"

#: lib/elements/fill_stitch.py:38
msgid ""
"This fill object is so small that it would probably look better as running "
"stitch or satin column. For very small shapes, fill stitch is not possible, "
"and Ink/Stitch will use running stitch around the outline instead."
msgstr ""
"Este preenchimento é tão pequeno que provavelmente ficará melhor como ponto "
"corrido ou coluna de cetim. Em formas muito pequenas, o preenchimento não é "
"possível e o Ink/Stitch usa ponto corrido no contorno."

#: lib/elements/fill_stitch.py:44 lib/elements/fill_stitch.py:277
msgid "Expand"
msgstr "Expandir"

#: lib/elements/fill_stitch.py:45
msgid ""
"The expand parameter for this fill object cannot be applied. Ink/Stitch will"
" ignore it and will use original size instead."
msgstr ""
"O parâmetro de expansão não pode ser aplicado a este preenchimento. O "
"Ink/Stitch o ignorará e usará o tamanho original."

#: lib/elements/fill_stitch.py:50 lib/elements/fill_stitch.py:736
msgid "Inset"
msgstr "Inserir"

#: lib/elements/fill_stitch.py:51
msgid ""
"The underlay inset parameter for this fill object cannot be applied. "
"Ink/Stitch will ignore it and will use the original size instead."
msgstr ""
"O parâmetro de recuo da subcamada não pode ser aplicado a este "
"preenchimento. O Ink/Stitch o ignorará e usará o tamanho original."

#: lib/elements/fill_stitch.py:56
msgid "Missing Guideline"
msgstr "Linha-guia ausente"

#: lib/elements/fill_stitch.py:57
msgid "This object is set to \"Guided Fill\", but has no guide line."
msgstr ""
"Este objeto está definido como “Preenchimento guiado”, mas não tem linha-"
"guia."

#: lib/elements/fill_stitch.py:59
msgid "* Create a stroke object"
msgstr "* Criar um objeto de traço"

#: lib/elements/fill_stitch.py:60
msgid ""
"* Select this object and run Extensions > Ink/Stitch > Edit > Selection to "
"guide line"
msgstr ""
"* Selecione este objeto e execute Extensões > Ink/Stitch > Editar > "
"Converter seleção em linha-guia"

#: lib/elements/fill_stitch.py:65
msgid "Disjointed Guide Line"
msgstr "Linha-guia desconectada"

#: lib/elements/fill_stitch.py:66
msgid ""
"The guide line of this object isn't within the object borders. The guide "
"line works best, if it is within the target element."
msgstr ""
"A linha-guia deste objeto está fora de seus limites. Ela funciona melhor "
"quando fica dentro do elemento de destino."

#: lib/elements/fill_stitch.py:69
msgid "* Move the guide line into the element"
msgstr "* Mova a linha-guia para dentro do elemento"

#: lib/elements/fill_stitch.py:74 lib/elements/stroke.py:30
msgid "Multiple Guide Lines"
msgstr "Várias linhas-guia"

#: lib/elements/fill_stitch.py:75 lib/elements/stroke.py:31
msgid ""
"This object has multiple guide lines, but only the first one will be used."
msgstr ""
"Este objeto tem várias linhas-guia, mas somente a primeira será usada."

#: lib/elements/fill_stitch.py:77 lib/elements/stroke.py:32
msgid "* Remove all guide lines, except for one."
msgstr "* Remova todas as linhas-guia, exceto uma."

#: lib/elements/fill_stitch.py:82
msgid "Unconnected"
msgstr "Desconectado"

#: lib/elements/fill_stitch.py:83
msgid ""
"Fill: This object is made up of unconnected shapes. Ink/Stitch doesn't know "
"what order to stitch them in.  Please break this object up into separate "
"shapes."
msgstr ""
"Preenchimento: este objeto contém formas desconectadas, e o Ink/Stitch não "
"sabe em que ordem bordá-las. Separe-o em formas individuais."

#: lib/elements/fill_stitch.py:87 lib/elements/fill_stitch.py:96
#: lib/elements/fill_stitch.py:153
msgid "* Extensions > Ink/Stitch > Fill Tools > Break Apart Fill Objects"
msgstr ""
"* Extensões > Ink/Stitch > Ferramentas de preenchimento > Separar objetos de"
" preenchimento"

#: lib/elements/fill_stitch.py:92
msgid "Border crosses itself"
msgstr "O contorno cruza a si mesmo"

#: lib/elements/fill_stitch.py:93
msgid ""
"Fill: The border crosses over itself. This may lead into unconnected shapes."
" Please break this object into separate shapes to indicate in which order it"
" should be stitched in."
msgstr ""
"Preenchimento: o contorno cruza a si mesmo e pode criar formas "
"desconectadas. Separe o objeto em formas individuais para indicar a ordem do"
" bordado."

#: lib/elements/fill_stitch.py:101
msgid "Fill and Stroke color"
msgstr "Cor do preenchimento e do traço"

#: lib/elements/fill_stitch.py:102
msgid ""
"Element has both a fill and a stroke color. It is recommended to use two "
"separate elements instead."
msgstr ""
"O elemento tem cor de preenchimento e de traço. Recomenda-se usar dois "
"elementos separados."

#: lib/elements/fill_stitch.py:104
msgid ""
"* Duplicate the element. Remove stroke color from the first and fill color "
"from the second."
msgstr ""
"* Duplique o elemento. Remova a cor do traço do primeiro e a cor do "
"preenchimento do segundo."

#: lib/elements/fill_stitch.py:105
msgid ""
"* Adapt the shape of the second element to compensate for push and pull "
"fabric distortion."
msgstr ""
"* Ajuste a forma do segundo elemento para compensar a expansão e o repuxo do"
" tecido."

#: lib/elements/fill_stitch.py:110
msgid "No linear gradient color"
msgstr "Nenhuma cor de gradiente linear"

#: lib/elements/fill_stitch.py:111
msgid "Linear Gradient has no linear gradient color."
msgstr "O gradiente linear não tem uma cor de gradiente linear."

#: lib/elements/fill_stitch.py:113
msgid "* Open the Fill and Stroke dialog."
msgstr "* Abra a janela Preenchimento e traço."

#: lib/elements/fill_stitch.py:114
msgid "* Set a linear gradient as a fill and adapt colors to your liking."
msgstr ""
"* Defina um gradiente linear como preenchimento e ajuste as cores a seu "
"gosto."

#: lib/elements/fill_stitch.py:119
msgid "No stripes to render"
msgstr "Não há faixas para renderizar"

#: lib/elements/fill_stitch.py:120
msgid "Tartan fill: There is no active fill stripe to render"
msgstr ""
"Preenchimento tartã: não há uma faixa de preenchimento ativa para renderizar"

#: lib/elements/fill_stitch.py:122
msgid ""
"Go to Extensions > Ink/Stitch > Fill Tools > Tartan and adjust stripe "
"settings:"
msgstr ""
"Vá até Extensões > Ink/Stitch > Ferramentas de preenchimento > Tartã e "
"ajuste as faixas:"

#: lib/elements/fill_stitch.py:123
msgid "* Check if stripes are active"
msgstr "* Verifique se as faixas estão ativas"

#: lib/elements/fill_stitch.py:124
msgid "* Check the minimum stripe width setting and the scale factor"
msgstr "* Verifique a largura mínima da faixa e o fator de escala"

#: lib/elements/fill_stitch.py:129
msgid "No customized pattern"
msgstr "Nenhum padrão personalizado"

#: lib/elements/fill_stitch.py:130
msgid "Tartan fill: Using default pattern"
msgstr "Preenchimento tartã: usando o padrão predefinido"

#: lib/elements/fill_stitch.py:132
msgid ""
"Go to Extensions > Ink/Stitch > Tools: Fill > Tartan and adjust stripe "
"settings:"
msgstr ""
"Vá até Extensões > Ink/Stitch > Ferramentas: preenchimento > Tartã e ajuste "
"as faixas:"

#: lib/elements/fill_stitch.py:133
msgid "* Customize your pattern"
msgstr "* Personalizar seu padrão"

#: lib/elements/fill_stitch.py:138
msgid "Cross stitch: shape too small"
msgstr "Ponto cruz: forma pequena demais"

#: lib/elements/fill_stitch.py:139
msgid ""
"This shape is too small to fit a cross. Please adapt params and/or shape."
msgstr ""
"Esta forma é pequena demais para conter uma cruz. Ajuste os parâmetros e/ou "
"a forma."

#: lib/elements/fill_stitch.py:141
msgid "* Change the pattern size"
msgstr "* Alterar o tamanho do padrão"

#: lib/elements/fill_stitch.py:142
msgid "* Or adapt the grid offset or move the shape"
msgstr "* Ou ajuste o deslocamento da grade ou mova a forma"

#: lib/elements/fill_stitch.py:143
msgid "* Or increase the expand value or increase shape size"
msgstr "* Ou aumente o valor de expansão ou o tamanho da forma"

#: lib/elements/fill_stitch.py:144
msgid "* Or decrease the fill coverage value"
msgstr "* Ou diminua o valor da cobertura do preenchimento"

#: lib/elements/fill_stitch.py:145
msgid ""
"* Or use Extensions > Ink/Stitch > Tools: Fill > Cross Stitch Assistant, "
"adapt settings and pixelate the shape"
msgstr ""
"* Ou use Extensões > Ink/Stitch > Ferramentas: preenchimento > Assistente de"
" ponto cruz, ajuste as configurações e pixelize a forma"

#: lib/elements/fill_stitch.py:150
msgid "This shape is invalid"
msgstr "Esta forma é inválida"

#: lib/elements/fill_stitch.py:151
msgid ""
"Fill: This shape cannot be stitched out. Please try to repair it with the "
"\"Break Apart Fill Objects\" extension."
msgstr ""
"Preenchimento: esta forma não pode ser bordada. Tente repará-la com a "
"extensão “Separar objetos de preenchimento”."

#: lib/elements/fill_stitch.py:159
msgid "FillStitch"
msgstr "Ponto de preenchimento"

#: lib/elements/fill_stitch.py:162
msgid "Fill stitching"
msgstr "costura de preenchimento"

#: lib/elements/fill_stitch.py:166 lib/gui/tartan/embroidery_panel.py:202
#: inx/inkstitch_select_elements.inx:55
msgid "Tatami Fill"
msgstr "preenchimento tatami"

#: lib/elements/fill_stitch.py:167 inx/inkstitch_select_elements.inx:56
msgid "Circular Fill"
msgstr "Preenchimento circular"

#: lib/elements/fill_stitch.py:168 inx/inkstitch_select_elements.inx:57
msgid "Contour Fill"
msgstr "Preenchimento por contorno"

#: lib/elements/fill_stitch.py:169 lib/lettering/categories.py:20
#: inx/inkstitch_lettering_generate_json.inx:60
msgid "Cross Stitch"
msgstr "ponto cruz"

#: lib/elements/fill_stitch.py:170 inx/inkstitch_select_elements.inx:58
msgid "Guided Fill"
msgstr "Preenchimento guiado"

#: lib/elements/fill_stitch.py:171 inx/inkstitch_select_elements.inx:59
msgid "Linear Gradient Fill"
msgstr "Preenchimento com gradiente linear"

#: lib/elements/fill_stitch.py:172 inx/inkstitch_select_elements.inx:60
msgid "Meander Fill"
msgstr "Preenchimento serpenteado"

#: lib/elements/fill_stitch.py:173 inx/inkstitch_select_elements.inx:61
msgid "Tartan Fill"
msgstr "Preenchimento tartã"

#: lib/elements/fill_stitch.py:174 lib/gui/tartan/embroidery_panel.py:203
#: inx/inkstitch_select_elements.inx:62
msgid "Legacy Fill"
msgstr "preenchimento legado"

#: lib/elements/fill_stitch.py:178
msgid "Fill method"
msgstr "Método de preenchimento"

#: lib/elements/fill_stitch.py:187
msgid "Guided Fill Strategy"
msgstr "Estratégia de preenchimento guiado"

#: lib/elements/fill_stitch.py:188
msgid "Copy"
msgstr "Copiar"

#: lib/elements/fill_stitch.py:188
msgid "Parallel Offset"
msgstr "deslocamento paralelo"

#: lib/elements/fill_stitch.py:188
msgid "Buffer"
msgstr "margem"

#: lib/elements/fill_stitch.py:189
msgid ""
"Copy (the default) will fill the shape with shifted copies of the line. "
"Parallel offset will ensure that each line is always a consistent distance "
"from its neighbor. Sharp corners may be introduced."
msgstr ""
"Copiar, a opção padrão, preenche a forma com cópias deslocadas da linha. "
"Deslocamento paralelo mantém distância constante entre linhas vizinhas, mas "
"pode criar cantos agudos."

#: lib/elements/fill_stitch.py:196
msgid "Contour Fill Strategy"
msgstr "Estratégia de preenchimento de contorno"

#: lib/elements/fill_stitch.py:197
msgid "Inner to Outer"
msgstr "Do interior para o exterior"

#: lib/elements/fill_stitch.py:197
msgid "Single spiral"
msgstr "Espiral simples"

#: lib/elements/fill_stitch.py:197
msgid "Double spiral"
msgstr "Espiral dupla"

#: lib/elements/fill_stitch.py:202
msgid "Join Style"
msgstr "Estilo da junção"

#: lib/elements/fill_stitch.py:203 inx/inkstitch_knockdown_fill.inx:22
#: inx/inkstitch_knockdown_fill.inx:41
msgid "Round"
msgstr "arredondado"

#: lib/elements/fill_stitch.py:203
msgid "Mitered"
msgstr "Em meia-esquadria"

#: lib/elements/fill_stitch.py:203
msgid "Beveled"
msgstr "Chanfrado"

#: lib/elements/fill_stitch.py:209
msgid "Avoid self-crossing"
msgstr "Evitar auto cruzamento"

#: lib/elements/fill_stitch.py:218
msgid "Clockwise"
msgstr "Sentido horário"

#: lib/elements/fill_stitch.py:223
msgid "Meander Pattern"
msgstr "Padrão de serpenteado"

#: lib/elements/fill_stitch.py:230
msgid "Meander pattern angle"
msgstr "Ângulo do padrão de serpenteado"

#: lib/elements/fill_stitch.py:240
msgid "Meander pattern scale"
msgstr "Escala do padrão de serpenteado"

#: lib/elements/fill_stitch.py:241
msgid ""
"Percentage to stretch or compress the meander pattern.  You can scale "
"horizontally and vertically individually by giving two percentages separated"
" by a space. "
msgstr ""
"Percentual de alongamento ou compressão do padrão meandrado. Dois "
"percentuais separados por espaço redimensionam horizontal e verticalmente de"
" forma independente. "

#: lib/elements/fill_stitch.py:251
msgid "Clip path"
msgstr "caminho de recorte"

#: lib/elements/fill_stitch.py:252
msgid ""
"Constrain stitching to the shape.  Useful when smoothing and expand are "
"used."
msgstr ""
"Restringir os pontos à forma. Útil quando são usadas suavização e expansão."

#: lib/elements/fill_stitch.py:261
msgid "Smoothness"
msgstr "suavidade"

#: lib/elements/fill_stitch.py:263
msgid ""
"Smooth the stitch path.  Smoothness limits how far the smoothed stitch path "
"is allowed to deviate from the original path.  Try low numbers like 0.2.  "
"Hint: a lower running stitch tolerance may be needed too."
msgstr ""
"Suavizar o caminho de pontos. A suavidade limita quanto o caminho suavizado "
"pode se afastar do original. Experimente valores baixos, como 0,2; talvez "
"também seja necessária tolerância menor no ponto corrido."

#: lib/elements/fill_stitch.py:278
msgid ""
"Expand the shape before fill stitching, to compensate for gaps between "
"shapes.  Negative values contract instead."
msgstr ""
"Expandir a forma antes do preenchimento para compensar lacunas entre formas."
" Valores negativos a contraem."

#: lib/elements/fill_stitch.py:288
msgid "Gap Filling"
msgstr "Preenchimento de lacunas"

#: lib/elements/fill_stitch.py:289
msgid ""
"Add extra rows to compensate for gaps between sections caused by "
"distortion.Rows are always added in pairs, so this number will be rounded up"
" to the nearest multiple of 2."
msgstr ""
"Adicionar linhas extras para compensar lacunas entre seções causadas por "
"distorção. As linhas são acrescentadas aos pares; o valor será arredondado "
"para o múltiplo de 2 seguinte."

#: lib/elements/fill_stitch.py:301 lib/elements/fill_stitch.py:334
#: lib/gui/tartan/embroidery_panel.py:35
msgid "Angle of lines of stitches"
msgstr "Ângulo das linhas de pontos"

#: lib/elements/fill_stitch.py:302
msgid ""
"The angle increases in a counter-clockwise direction.  0 is horizontal.  "
"Negative angles are allowed."
msgstr ""
"O ângulo aumenta no sentido anti-horário. Zero é horizontal. Ângulos "
"negativos são permitidos."

#: lib/elements/fill_stitch.py:315
msgid "Guide copy angle"
msgstr "Ângulo da cópia da guia"

#: lib/elements/fill_stitch.py:316
msgid ""
"Angle for guide line shifting. Changing the angle may have a huge impact on "
"the actual spacing between the rows. Ensure the guide line is large enough "
"to fill the area when shifted into the given angle."
msgstr ""
"Ângulo de deslocamento da linha-guia. Alterá-lo pode afetar muito o "
"espaçamento real entre as linhas. Garanta que a linha-guia seja grande o "
"bastante para preencher a área no ângulo definido."

#: lib/elements/fill_stitch.py:335 lib/gui/tartan/embroidery_panel.py:36
msgid "Relative to the tartan stripe direction."
msgstr "Em relação à direção das faixas tartã."

#: lib/elements/fill_stitch.py:347
msgid "Maximum fill stitch length"
msgstr "Comprimento máximo do ponto de preenchimento"

#: lib/elements/fill_stitch.py:349 lib/elements/fill_stitch.py:913
msgid ""
"The length of each stitch in a row.  Shorter stitch may be used at the start"
" or end of a row."
msgstr ""
"Comprimento de cada ponto de uma linha. Pontos menores podem ser usados no "
"início ou no fim da linha."

#: lib/elements/fill_stitch.py:365
msgid "Spacing between rows"
msgstr "Espaçamento entre linhas"

#: lib/elements/fill_stitch.py:366
msgid "Distance between rows of stitches."
msgstr "Distância entre linhas de costura."

#: lib/elements/fill_stitch.py:383 inx/inkstitch_gradient_blocks.inx:24
msgid "End row spacing"
msgstr "espaçamento final entre linhas"

#: lib/elements/fill_stitch.py:384
msgid "Increases or decreases the row spacing towards the end."
msgstr "Aumenta ou diminui o espaçamento entre linhas em direção ao final."

#: lib/elements/fill_stitch.py:397
msgid "Flexible"
msgstr "Flexível"

#: lib/elements/fill_stitch.py:398
msgid "Flexible (stagger)"
msgstr "Flexível (alternado)"

#: lib/elements/fill_stitch.py:403
msgid "Stitch position method"
msgstr "Método de posicionamento dos pontos"

#: lib/elements/fill_stitch.py:404
msgid ""
"Flexible: adapts stitch lenghts accordingly to the tolerance value while keeping stitch length consistent on each curve segment.\n"
"Flexible (stagger): adapts stitch length accordingly to the tolerance value while also optimizing for stagger."
msgstr ""
"Flexível: adapta os comprimentos à tolerância, mantendo-os uniformes em cada segmento da curva.\n"
"Flexível (alternado): também adapta o comprimento à tolerância, otimizando a alternância."

#: lib/elements/fill_stitch.py:416
msgid "Stagger rows this many times before repeating"
msgstr "Alternar as linhas esta quantidade de vezes antes de repetir"

#: lib/elements/fill_stitch.py:417 lib/elements/satin_column.py:227
msgid ""
"Length of the cycle by which successive stitch rows are staggered. "
"Fractional values are allowed and can have less visible diagonals than "
"integer values."
msgstr ""
"Comprimento do ciclo que alterna as linhas sucessivas de pontos. Valores "
"fracionários são permitidos e podem produzir diagonais menos visíveis que "
"valores inteiros."

#: lib/elements/fill_stitch.py:433 lib/elements/fill_stitch.py:748
msgid "Skip last stitch in each row"
msgstr "Pule o último ponto de cada linha"

#: lib/elements/fill_stitch.py:434 lib/elements/fill_stitch.py:749
msgid ""
"The last stitch in each row is quite close to the first stitch in the next "
"row.  Skipping it decreases stitch count and density."
msgstr ""
"O último ponto de cada linha é bastante próximo ao primeiro ponto da próxima"
" linha. Ignorá-lo diminui a densidade e a contagem de pontos."

#: lib/elements/fill_stitch.py:449
msgid "Flip fill (start right-to-left)"
msgstr "Inverter preenchimento (iniciar da direita para a esquerda)"

#: lib/elements/fill_stitch.py:450
msgid ""
"The flip option can help you with routing your stitch path.  When you enable"
" flip, stitching goes from right-to-left instead of left-to-right."
msgstr ""
"A opção Inverter pode ajudar no roteamento. Quando ativada, o bordado segue "
"da direita para a esquerda em vez da esquerda para a direita."

#: lib/elements/fill_stitch.py:462
msgid "Reverse fill"
msgstr "inverter preenchimento"

#: lib/elements/fill_stitch.py:463
msgid "Reverses fill path."
msgstr "Inverte o caminho do preenchimento."

#: lib/elements/fill_stitch.py:474
msgid "Stop at ending point"
msgstr "Parar no ponto final"

#: lib/elements/fill_stitch.py:475
msgid ""
"If this option is disabled, the ending point will only be used to define a "
"general direction for stitch routing. When enabled the last section will end"
" at the defined spot."
msgstr ""
"Quando desativada, a posição final define apenas a direção geral do "
"roteamento. Quando ativada, a última seção termina no local definido."

#: lib/elements/fill_stitch.py:487 lib/elements/fill_stitch.py:760
msgid "Underpath"
msgstr "caminho inferior"

#: lib/elements/fill_stitch.py:488 lib/elements/fill_stitch.py:761
msgid ""
"Travel inside the shape when moving from section to section.  Underpath "
"stitches avoid traveling in the direction of the row angle so that they are "
"not visible.  This gives them a jagged appearance."
msgstr ""
"Deslocar-se dentro da forma entre as seções. Os pontos do caminho inferior "
"evitam seguir o ângulo das linhas para não ficarem visíveis, o que lhes dá "
"aparência serrilhada."

#: lib/elements/fill_stitch.py:500 lib/elements/satin_column.py:389
#: lib/elements/stroke.py:156
msgid "Running stitch length"
msgstr "Comprimento do ponto corrido"

#: lib/elements/fill_stitch.py:501
msgid ""
"Length of stitches around the outline of the fill region used when moving "
"from section to section. Also used for meander and circular fill."
msgstr ""
"Comprimento dos pontos ao redor do contorno da região preenchida ao passar "
"de uma seção a outra. Também usado nos preenchimentos meandrado e circular."

#: lib/elements/fill_stitch.py:518 lib/elements/satin_column.py:400
msgid "Running stitch tolerance"
msgstr "Tolerância do ponto corrido"

#: lib/elements/fill_stitch.py:519 lib/elements/satin_column.py:401
msgid ""
"Determines how hard Ink/Stitch tries to avoid stitching outside the "
"shape.Lower numbers are less likely to stitch outside the shape but require "
"more stitches."
msgstr ""
"Define o quanto o Ink/Stitch evita bordar fora da forma. Valores menores "
"reduzem essa possibilidade, mas exigem mais pontos."

#: lib/elements/fill_stitch.py:537 lib/elements/stroke.py:200
msgid "Randomize stitch length"
msgstr "Variar aleatoriamente o comprimento do ponto"

#: lib/elements/fill_stitch.py:538 lib/elements/stroke.py:202
msgid ""
"Randomize stitch length and phase instead of dividing evenly or staggering. "
"This is recommended for closely-spaced curved fills to avoid Moiré "
"artefacts."
msgstr ""
"Variar aleatoriamente o comprimento e a fase dos pontos em vez de dividi-los"
" uniformemente ou alterná-los. Recomendado em preenchimentos curvos próximos"
" para evitar efeito moiré."

#: lib/elements/fill_stitch.py:554 lib/elements/stroke.py:221
msgid "Random stitch length jitter"
msgstr "Variação aleatória do comprimento do ponto"

#: lib/elements/fill_stitch.py:555 lib/elements/stroke.py:222
msgid "Amount to vary the length of each stitch by when randomizing."
msgstr ""
"Variação aplicada ao comprimento de cada ponto durante a aleatoriedade."

#: lib/elements/fill_stitch.py:570 lib/elements/satin_column.py:525
#: lib/elements/stroke.py:99
#: lib/sew_stack/stitch_layers/running_stitch/running_stitch_layer.py:33
#: lib/sew_stack/stitch_layers/running_stitch/running_stitch_layer.py:35
msgid "Repeats"
msgstr "Repetições"

#: lib/elements/fill_stitch.py:571 lib/elements/stroke.py:100
#: lib/sew_stack/stitch_layers/running_stitch/running_stitch_layer.py:36
msgid "Defines how many times to run down and back along the path."
msgstr "Define quantas vezes percorrer o caminho em ida e volta."

#: lib/elements/fill_stitch.py:583 lib/elements/stroke.py:117
msgid "Bean stitch number of repeats"
msgstr "Número de repetições do ponto feijão"

#: lib/elements/fill_stitch.py:584 lib/elements/stroke.py:119
msgid ""
"Backtrack each stitch this many times.  A value of 1 would triple each stitch (forward, back, forward).  A value of 2 would quintuple each stitch, etc.\n"
"\n"
"A pattern with various repeats can be created with a list of values separated by a space."
msgstr ""
"Refazer cada ponto esta quantidade de vezes. O valor 1 triplica o ponto (frente, trás, frente); o valor 2 o quintuplica, e assim por diante.\n"
"\n"
"Uma lista de valores separados por espaço cria um padrão com repetições variadas."

#: lib/elements/fill_stitch.py:601 lib/elements/satin_column.py:264
#: lib/elements/stroke.py:256
msgid "Zig-zag spacing (peak-to-peak)"
msgstr "Espaçamento do zigue-zague (entre picos)"

#: lib/elements/fill_stitch.py:602 lib/elements/stroke.py:257
msgid "Length of stitches in zig-zag mode."
msgstr "Comprimento dos pontos no modo zigue-zague."

#: lib/elements/fill_stitch.py:614
msgid "Zig-zag width"
msgstr "Largura do zigue-zague"

#: lib/elements/fill_stitch.py:615
msgid "Width of the zig-zag line."
msgstr "Largura da linha em zigue-zague."

#: lib/elements/fill_stitch.py:628 lib/gui/tartan/embroidery_panel.py:42
msgid "Rows per tartan thread"
msgstr "Linhas por fio tartã"

#: lib/elements/fill_stitch.py:629 lib/gui/tartan/embroidery_panel.py:44
msgid "Consecutive rows of the same color"
msgstr "Linhas consecutivas da mesma cor"

#: lib/elements/fill_stitch.py:640
msgid "Herringbone width"
msgstr "Largura da espinha de peixe"

#: lib/elements/fill_stitch.py:641
msgid "Defines width of a herringbone pattern. Use 0 for regular rows."
msgstr ""
"Define a largura do padrão espinha de peixe. Use 0 para linhas normais."

#: lib/elements/fill_stitch.py:653 lib/elements/satin_column.py:292
#: lib/elements/stroke.py:272
msgid "Pull compensation"
msgstr "compensação de repuxo"

#: lib/elements/fill_stitch.py:654
msgid ""
"Fill stitch can pull the fabric together, resulting in a shape narrower than"
" you draw in Inkscape. This setting expands each row of stitches outward "
"from the center of the row by a fixed length. Two values separated by a "
"space may be used for an asymmetric effect."
msgstr ""
"O preenchimento repuxa o tecido e pode produzir uma forma mais estreita que "
"a desenhada. Esta opção expande cada linha para fora do centro por um "
"comprimento fixo. Dois valores separados por espaço produzem efeito "
"assimétrico."

#: lib/elements/fill_stitch.py:658 lib/elements/satin_column.py:296
#: lib/elements/satin_column.py:318 lib/elements/satin_column.py:470
#: lib/elements/satin_column.py:564 lib/elements/stroke.py:278
msgid "mm (each side)"
msgstr "mm (para cada lado)"

#: lib/elements/fill_stitch.py:669 lib/elements/satin_column.py:277
msgid "Pull compensation percentage"
msgstr "Percentual de compensação de repuxo"

#: lib/elements/fill_stitch.py:670
msgid ""
"Additional pull compensation which varies as a percentage of row width. Two "
"values separated by a space may be used for an asymmetric effect."
msgstr ""
"Compensação adicional de repuxo, expressa como percentual da largura da "
"linha. Dois valores separados por espaço produzem efeito assimétrico."

#: lib/elements/fill_stitch.py:673 lib/elements/satin_column.py:144
#: lib/elements/satin_column.py:154 lib/elements/satin_column.py:280
#: lib/elements/satin_column.py:485 lib/elements/satin_column.py:584
msgid "% (each side)"
msgstr "% (para cada lado)"

#: lib/elements/fill_stitch.py:682 lib/elements/fill_stitch.py:691
#: lib/elements/fill_stitch.py:718 lib/elements/fill_stitch.py:729
#: lib/elements/fill_stitch.py:739 lib/elements/fill_stitch.py:751
#: lib/elements/fill_stitch.py:764
msgid "Fill Underlay"
msgstr "subcamada do preenchimento"

#: lib/elements/fill_stitch.py:682 lib/gui/tartan/embroidery_panel.py:55
#: inx/inkstitch_select_elements.inx:36 inx/inkstitch_select_elements.inx:64
#: inx/inkstitch_select_elements.inx:66
msgid "Underlay"
msgstr "subcamada"

#: lib/elements/fill_stitch.py:688
msgid "Fill angle"
msgstr "ângulo do preenchimento"

#: lib/elements/fill_stitch.py:689
msgid ""
"Default: fill angle + 90 deg. Insert a list for multiple layers separated by"
" a space."
msgstr ""
"Padrão: ângulo do preenchimento + 90 graus. Para várias camadas, insira uma "
"lista separada por espaços."

#: lib/elements/fill_stitch.py:715 lib/gui/tartan/embroidery_panel.py:77
msgid "Row spacing"
msgstr "Espaçamento da linha"

#: lib/elements/fill_stitch.py:716
msgid "default: 3x fill row spacing"
msgstr "padrão: três vezes o espaçamento das linhas de preenchimento"

#: lib/elements/fill_stitch.py:726 lib/elements/stroke.py:239
#: lib/extensions/element_info.py:144 lib/extensions/element_info.py:203
msgid "Max stitch length"
msgstr "Comprimento máximo do ponto"

#: lib/elements/fill_stitch.py:727
msgid "default: equal to fill max stitch length"
msgstr "padrão: igual ao comprimento máximo do ponto de preenchimento"

#: lib/elements/fill_stitch.py:737
msgid ""
"Shrink the shape before doing underlay, to prevent underlay from showing "
"around the outside of the fill."
msgstr ""
"Reduza a forma antes de fazer a base, para evitar que a base apareça na "
"parte externa do preenchimento."

#: lib/elements/fill_stitch.py:772 lib/elements/satin_column.py:606
#: lib/elements/stroke.py:620 lib/gui/satin_multicolor/colorize_panel.py:62
#: lib/sew_stack/stitch_layers/mixins/randomization.py:55
msgid "Random seed"
msgstr "Semente aleatória"

#: lib/elements/fill_stitch.py:773 lib/elements/satin_column.py:607
#: lib/elements/stroke.py:621
msgid ""
"Use a specific seed for randomized attributes. Uses the element ID if empty."
msgstr ""
"Usar uma semente específica nos atributos aleatórios. Se estiver vazio, usa "
"o identificador do elemento."

#: lib/elements/fill_stitch.py:793 lib/stitch_plan/lock_stitch.py:218
msgid "Cross"
msgstr "Cruz"

#: lib/elements/fill_stitch.py:794
msgid "Cross Flipped"
msgstr "Cruz invertida"

#: lib/elements/fill_stitch.py:795
msgid "Half Cross"
msgstr "Meia cruz"

#: lib/elements/fill_stitch.py:796
msgid "Half Cross Flipped"
msgstr "Meia cruz invertida"

#: lib/elements/fill_stitch.py:797
msgid "Upright Cross"
msgstr "Cruz vertical"

#: lib/elements/fill_stitch.py:798
msgid "Upright Cross Flipped"
msgstr "Cruz vertical invertida"

#: lib/elements/fill_stitch.py:799
msgid "Dense Upright Cross"
msgstr "Cruz vertical densa"

#: lib/elements/fill_stitch.py:800
msgid "Dense Upright Cross Flipped"
msgstr "Cruz vertical densa invertida"

#: lib/elements/fill_stitch.py:801
msgid "Double Cross"
msgstr "Cruz dupla"

#: lib/elements/fill_stitch.py:802
msgid "Double Cross Flipped"
msgstr "Cruz dupla invertida"

#: lib/elements/fill_stitch.py:803
msgid "Smyrna Cross"
msgstr "Cruz de Esmirna"

#: lib/elements/fill_stitch.py:804
msgid "Smyrna Cross Flipped"
msgstr "Cruz de Esmirna invertida"

#: lib/elements/fill_stitch.py:809 lib/gui/cross_stitch_assistant.py:112
msgid "Cross stitch method"
msgstr "Método do ponto cruz"

#: lib/elements/fill_stitch.py:820
msgid "Thread count"
msgstr "quantidade de linhas"

#: lib/elements/fill_stitch.py:821
msgid ""
"Defines the thread count for each stitch.\n"
"Thread count must be an even number.\n"
"Half crosses are stitched with an odd thread count."
msgstr ""
"Define a quantidade de fios de cada ponto.\n"
"Ela deve ser um número par.\n"
"Meias cruzes são bordadas com uma quantidade ímpar de fios."

#: lib/elements/fill_stitch.py:834
msgid "Pattern size"
msgstr "tamanho do padrão"

#: lib/elements/fill_stitch.py:835
msgid ""
"Cross stitch pattern size in mm, x and y values are separated by a space. "
"Only one input value returns a square pattern."
msgstr ""
"Tamanho do padrão de ponto cruz em mm. Separe X e Y por espaço; um único "
"valor produz um padrão quadrado."

#: lib/elements/fill_stitch.py:838 lib/elements/fill_stitch.py:871
msgid "mm (x y)"
msgstr "mm (x y)"

#: lib/elements/fill_stitch.py:850
msgid "Align grid with canvas"
msgstr "Alinhar grade à tela"

#: lib/elements/fill_stitch.py:851
msgid ""
"This ensures good alignment for adjacent cross stitch areas, but it also means that the outcome may change when the element is moved off the grid.\n"
"\n"
"Disable this option to ensure, that this element stitches the same, independently on its position on the canvas."
msgstr ""
"Isso alinha corretamente áreas adjacentes de ponto cruz, mas o resultado pode mudar se o elemento sair da grade.\n"
"\n"
"Desative a opção para que o elemento seja bordado sempre da mesma forma, independentemente da posição na tela."

#: lib/elements/fill_stitch.py:867
msgid "Grid Offset"
msgstr "deslocamento da grade"

#: lib/elements/fill_stitch.py:868
msgid ""
"Shifts the cross stitch grid by given values. X and Y values are separated "
"by a space. Only one input value offsets the pattern evenly for x and y."
msgstr ""
"Desloca a grade de ponto cruz pelos valores fornecidos. Separe X e Y por "
"espaço; um único valor desloca o padrão igualmente nos dois eixos."

#: lib/elements/fill_stitch.py:883
msgid "Grid Rotation"
msgstr "rotação da grade"

#: lib/elements/fill_stitch.py:884
msgid "Rotates the cross stitch grid by the given value."
msgstr "Gira a grade de ponto cruz pelo valor fornecido."

#: lib/elements/fill_stitch.py:886
msgid "deg"
msgstr "graus"

#: lib/elements/fill_stitch.py:898
msgid "Fill coverage"
msgstr "cobertura do preenchimento"

#: lib/elements/fill_stitch.py:899
msgid "Percentage of overlap for each cross with the fill area"
msgstr "Percentual de sobreposição de cada cruz com a área de preenchimento"

#: lib/elements/fill_stitch.py:911 lib/elements/satin_column.py:185
#: lib/elements/satin_column.py:595
msgid "Maximum stitch length"
msgstr "Comprimento máximo do ponto"

#: lib/elements/image.py:18
msgid "Image"
msgstr "Imagem"

#: lib/elements/image.py:19
msgid "Ink/Stitch can't work with objects like images."
msgstr "O Ink/Stitch não trabalha com objetos como imagens."

#: lib/elements/image.py:21
msgid "* Redraw the image with the pen (P) or bezier (B) tool"
msgstr "* Redesenhe a imagem com a ferramenta Caneta (P) ou Bézier (B)"

#: lib/elements/image.py:22
msgid ""
"* Alternatively convert your image into a path: Path > Trace Bitmap... "
"(Shift+Alt+B) (further steps might be required)"
msgstr ""
"* Como alternativa, converta a imagem em caminho: Caminho > Vetorizar "
"bitmap... (Shift+Alt+B). Outras etapas podem ser necessárias."

#: lib/elements/image.py:24
msgid ""
"* To convert the image for cross stitching, use Tools: Fill > Cross Stitch "
"Assistant"
msgstr ""
"* Para converter a imagem em ponto cruz, use Ferramentas: preenchimento > "
"Assistente de ponto cruz"

#: lib/elements/marker.py:14
msgid "Marker Element"
msgstr "Marcador"

#: lib/elements/marker.py:15
msgid ""
"This element will not be embroidered. It will be applied to objects in the "
"same group. Objects in sub-groups will be ignored."
msgstr ""
"Este elemento não será bordado. Ele será aplicado aos objetos do mesmo "
"grupo; objetos em subgrupos serão ignorados."

#: lib/elements/marker.py:18
msgid "Turn back to normal embroidery element mode, remove the marker:"
msgstr "Para voltar ao modo normal de elemento de bordado, remova o marcador:"

#: lib/elements/marker.py:19
msgid "* Open the Fill and Stroke panel (Objects > Fill and Stroke)"
msgstr ""
"* Abra o painel Preenchimento e traço (Objetos > Preenchimento e traço)"

#: lib/elements/marker.py:20
msgid "* Go to the Stroke style tab"
msgstr "* Vá até a guia Estilo do traço"

#: lib/elements/marker.py:21
msgid ""
"* Under \"Markers\" choose the first (empty) option in the first dropdown "
"list."
msgstr ""
"* Em “Marcadores”, escolha a primeira opção, vazia, da primeira lista "
"suspensa."

#: lib/elements/satin_column.py:34
msgid "Not stitchable satin column"
msgstr "Coluna de cetim que não pode ser bordada"

#: lib/elements/satin_column.py:35
msgid ""
"A satin column can be build from a single stroke or consists of two rails "
"and optional rungs. This satin column has a different setup."
msgstr ""
"Uma coluna de cetim pode ser formada por um único traço ou por dois trilhos "
"e degraus opcionais. Esta coluna tem outra estrutura."

#: lib/elements/satin_column.py:38
msgid ""
"Make sure your satin column is not a combination of multiple satin columns."
msgstr ""
"Verifique se a coluna de cetim não é uma combinação de várias colunas de "
"cetim."

#: lib/elements/satin_column.py:39
msgid ""
"Go to our website and read how a satin column should look like "
"https://inkstitch.org/docs/stitches/satin-column/"
msgstr ""
"Acesse nosso site para saber como deve ser uma coluna de cetim: "
"https://inkstitch.org/docs/stitches/satin-column/"

#: lib/elements/satin_column.py:43
msgid "Each rung should intersect both rails once."
msgstr "Cada degrau deve cruzar uma vez cada trilho."

#: lib/elements/satin_column.py:47
msgid "Rail is a closed path"
msgstr "O trilho é um caminho fechado"

#: lib/elements/satin_column.py:48
msgid "Rail is a closed path without a definite starting and ending point."
msgstr "O trilho é um caminho fechado sem pontos inicial e final definidos."

#: lib/elements/satin_column.py:50
msgid "* Select the node where you want the satin to start."
msgstr "* Selecione o nó em que o cetim deve começar."

#: lib/elements/satin_column.py:51
msgid "* Click on: Break path at selected nodes."
msgstr "* Clique em: Quebrar caminho nos nós selecionados."

#: lib/elements/satin_column.py:56
msgid "Rung doesn't intersect rails"
msgstr "O degrau não cruza os trilhos"

#: lib/elements/satin_column.py:57
msgid "Satin column: A rung doesn't intersect both rails."
msgstr "Coluna de cetim: um degrau não cruza os dois trilhos."

#: lib/elements/satin_column.py:61
msgid "Satin has no rungs"
msgstr "O cetim não tem degraus"

#: lib/elements/satin_column.py:62
msgid ""
"Rungs control the stitch direction in satin columns. It is best pratice to "
"use them."
msgstr ""
"Os degraus controlam a direção dos pontos nas colunas de cetim. Recomenda-se"
" usá-los."

#: lib/elements/satin_column.py:64 lib/elements/satin_column.py:96
#: lib/elements/satin_column.py:107
msgid "* With the selected object press \"P\" to activate the pencil tool."
msgstr ""
"* Com o objeto selecionado, pressione P para ativar a ferramenta Lápis."

#: lib/elements/satin_column.py:65 lib/elements/satin_column.py:97
msgid "* Hold \"Shift\" while drawing a rung."
msgstr "* Mantenha Shift pressionado ao desenhar um degrau."

#: lib/elements/satin_column.py:70
msgid "Rung intersects too many times"
msgstr "O degrau cruza os trilhos vezes demais"

#: lib/elements/satin_column.py:71
msgid "Satin column: A rung intersects a rail more than once."
msgstr "Coluna de cetim: um degrau cruza um trilho mais de uma vez."

#: lib/elements/satin_column.py:75
msgid "Simple Satin"
msgstr "cetim simples"

#: lib/elements/satin_column.py:78
msgid "* Select the satin path"
msgstr "* Selecionar o caminho de cetim"

#: lib/elements/satin_column.py:79
msgid "* Run Extensions > Ink/Stitch > Tools: Satin > Stroke to Satin"
msgstr ""
"* Execute Extensões > Ink/Stitch > Ferramentas: cetim > Traço para cetim"

#: lib/elements/satin_column.py:84
msgid "Narrow Satin"
msgstr "cetim estreito"

#: lib/elements/satin_column.py:85
msgid "This element renders as a satin, but it is too narrow."
msgstr "Este elemento é renderizado como cetim, mas é estreito demais."

#: lib/elements/satin_column.py:87 lib/elements/stroke.py:41
msgid "* Increase stroke width."
msgstr "* Aumentar a largura do traço."

#: lib/elements/satin_column.py:88
msgid ""
"Ink/Stitch will not register elements with a stroke width underneath 0.3 mm "
"as satin, but it is recommended to stay above 1mm."
msgstr ""
"O Ink/Stitch não reconhecerá como cetim elementos com traço menor que 0,3 "
"mm, e recomenda-se usar mais de 1 mm."

#: lib/elements/satin_column.py:93
msgid "Satin has exactly two rungs"
msgstr "O cetim tem exatamente dois degraus"

#: lib/elements/satin_column.py:94
msgid ""
"There are exactly two rungs. This may lead to false rail/rung detection."
msgstr ""
"Há exatamente dois degraus. Isso pode causar uma detecção incorreta de "
"trilhos e degraus."

#: lib/elements/satin_column.py:102
msgid "Unequal number of points"
msgstr "Número de pontos desigual"

#: lib/elements/satin_column.py:103
msgid ""
"Satin column: There are no rungs and rails have an unequal number of points."
msgstr ""
"Coluna de cetim: não há degraus e os trilhos têm quantidades diferentes de "
"pontos."

#: lib/elements/satin_column.py:105
msgid "The easiest way to solve this issue is to add one or more rungs. "
msgstr ""
"A maneira mais simples de resolver este problema é adicionar um ou mais "
"degraus. "

#: lib/elements/satin_column.py:106
msgid "Rungs control the stitch direction in satin columns."
msgstr "Os degraus controlam a direção dos pontos nas colunas de cetim."

#: lib/elements/satin_column.py:108
msgid "* Hold \"Shift\" while drawing the rung."
msgstr "* Mantenha Shift pressionado ao desenhar o degrau."

#: lib/elements/satin_column.py:114 lib/elements/satin_column.py:124
#: inx/inkstitch_select_elements.inx:31
msgid "Satin Column"
msgstr "coluna de cetim"

#: lib/elements/satin_column.py:120
msgid "Custom satin column"
msgstr "Coluna de cetim personalizada"

#: lib/elements/satin_column.py:125
msgid "\"E\" Stitch"
msgstr "Ponto \"E\""

#: lib/elements/satin_column.py:126
msgid "\"S\" Stitch"
msgstr "Ponto \"S\""

#: lib/elements/satin_column.py:127 lib/stitch_plan/lock_stitch.py:222
msgid "Zig-zag"
msgstr "Zig-zag"

#: lib/elements/satin_column.py:131 lib/elements/stroke.py:86
#: inx/inkstitch_break_apart.inx:9
msgid "Method"
msgstr "Método"

#: lib/elements/satin_column.py:141
msgid "Random percentage of satin width decrease"
msgstr "Percentual aleatório de redução da largura do cetim"

#: lib/elements/satin_column.py:142
msgid ""
"shorten stitch across rails at most this percent. Two values separated by a "
"space may be used for an asymmetric effect."
msgstr ""
"Encurtar o ponto entre os trilhos no máximo por este percentual. Dois "
"valores separados por espaço produzem efeito assimétrico."

#: lib/elements/satin_column.py:151
msgid "Random percentage of satin width increase"
msgstr "Percentual aleatório de aumento da largura do cetim"

#: lib/elements/satin_column.py:152
msgid ""
"lengthen stitch across rails at most this percent. Two values separated by a"
" space may be used for an asymmetric effect."
msgstr ""
"Alongar o ponto entre os trilhos no máximo por este percentual. Dois valores"
" separados por espaço produzem efeito assimétrico."

#: lib/elements/satin_column.py:161
msgid "Random zig-zag spacing percentage"
msgstr "Percentual aleatório do espaçamento do zigue-zague"

#: lib/elements/satin_column.py:162
msgid "Amount of random jitter added to zigzag spacing."
msgstr ""
"Quantidade de variação aleatória acrescentada ao espaçamento do zigue-zague."

#: lib/elements/satin_column.py:168
msgid "Default"
msgstr "Padrão"

#: lib/elements/satin_column.py:169 lib/stitch_plan/lock_stitch.py:220
#: inx/inkstitch_break_apart.inx:10
msgid "Simple"
msgstr "Simples"

#: lib/elements/satin_column.py:170
msgid "Staggered"
msgstr "Alternado"

#: lib/elements/satin_column.py:174
msgid "Split Method"
msgstr "Método de divisão"

#: lib/elements/satin_column.py:176
msgid ""
"Display needle penetration points in simulator to see the effect of each "
"split method."
msgstr ""
"Exibir no simulador os pontos de penetração da agulha para observar o efeito"
" de cada método de divisão."

#: lib/elements/satin_column.py:186
msgid "Maximum stitch length for split stitches."
msgstr "Comprimento máximo dos pontos divididos."

#: lib/elements/satin_column.py:195
msgid "Random jitter for split stitches"
msgstr "Variação aleatória dos pontos divididos"

#: lib/elements/satin_column.py:196
msgid ""
"Randomizes split stitch length if random phase is enabled, stitch position "
"if disabled."
msgstr ""
"Se a fase aleatória estiver ativada, varia o comprimento dos pontos "
"divididos; caso contrário, varia sua posição."

#: lib/elements/satin_column.py:204
msgid "Random phase for split stitches"
msgstr "Fase aleatória dos pontos divididos"

#: lib/elements/satin_column.py:205
msgid ""
"Controls whether split stitches are centered or with a random phase (which "
"may increase stitch count)."
msgstr ""
"Define se os pontos divididos ficam centralizados ou usam fase aleatória, "
"que pode aumentar a quantidade de pontos."

#: lib/elements/satin_column.py:213
msgid "Minimum length for random-phase split"
msgstr "Comprimento mínimo da divisão com fase aleatória"

#: lib/elements/satin_column.py:214
msgid ""
"Defaults to maximum stitch length. Smaller values allow for a transition "
"between single-stitch and split-stitch."
msgstr ""
"O padrão é o comprimento máximo do ponto. Valores menores permitem uma "
"transição entre ponto único e ponto dividido."

#: lib/elements/satin_column.py:224
msgid "Stagger split stitches this many times before repeating"
msgstr ""
"Alternar os pontos divididos esta quantidade de vezes antes de repetir"

#: lib/elements/satin_column.py:236
msgid "Short stitch inset"
msgstr "Recuo do ponto curto"

#: lib/elements/satin_column.py:237
msgid ""
"Stitches in areas with high density will be inset by this amount.Two values "
"separated by a space define inset levels if there are multiple consecutive "
"short stitches."
msgstr ""
"Pontos em áreas de alta densidade receberão este recuo. Dois valores "
"separados por espaço definem níveis de recuo quando houver vários pontos "
"curtos consecutivos."

#: lib/elements/satin_column.py:249
msgid "Short stitch distance"
msgstr "Distância do ponto curto"

#: lib/elements/satin_column.py:250
msgid "Inset stitches if the distance between stitches is smaller than this."
msgstr ""
"Recuar os pontos quando a distância entre eles for menor que este valor."

#: lib/elements/satin_column.py:265
msgid ""
"Peak-to-peak distance between zig-zags. This is double the mm/stitch "
"measurement used by most mechanical machines."
msgstr ""
"Distância entre os picos do zigue-zague. Corresponde ao dobro da medida em "
"mm por ponto usada pela maioria das máquinas mecânicas."

#: lib/elements/satin_column.py:278
msgid ""
"Additional pull compensation which varies as a percentage of stitch width. "
"Two values separated by a space may be used for an asymmetric effect."
msgstr ""
"Compensação adicional de repuxo, expressa como percentual da largura do "
"ponto. Dois valores separados por espaço produzem efeito assimétrico."

#: lib/elements/satin_column.py:293
msgid ""
"Satin stitches pull the fabric together, resulting in a column narrower than"
" you draw in Inkscape. This setting expands each pair of needle penetrations"
" outward from the center of the satin column by a fixed length. Two values "
"separated by a space may be used for an asymmetric effect."
msgstr ""
"Pontos cetim repuxam o tecido e produzem uma coluna mais estreita que a "
"desenhada. Esta opção expande cada par de penetrações para fora do centro "
"por um comprimento fixo. Dois valores separados por espaço produzem efeito "
"assimétrico."

#: lib/elements/satin_column.py:307 lib/elements/stroke.py:473
msgid "Automatic"
msgstr "Automático"

#: lib/elements/satin_column.py:308 lib/elements/stroke.py:474
msgid "Don't reverse"
msgstr "Não inverter"

#: lib/elements/satin_column.py:309 lib/elements/stroke.py:475
msgid "Reverse first rail"
msgstr "Inverter primeiro trilho"

#: lib/elements/satin_column.py:310 lib/elements/stroke.py:476
msgid "Reverse second rail"
msgstr "Inverter segundo trilho"

#: lib/elements/satin_column.py:311 lib/elements/stroke.py:477
msgid "Reverse both rails"
msgstr "Inverter ambos os trilhos"

#: lib/elements/satin_column.py:316
msgid "Push compensation"
msgstr "compensação de expansão"

#: lib/elements/satin_column.py:317
msgid "Shrinks the column at start and/or end."
msgstr "Estreita a coluna no início e/ou no fim."

#: lib/elements/satin_column.py:328 lib/elements/stroke.py:483
msgid "Reverse rails"
msgstr "Inverter trilhos"

#: lib/elements/satin_column.py:329
msgid ""
"This may help if your satin renders very strangely.  Default: automatically "
"detect and fix a reversed rail."
msgstr ""
"Isso pode ajudar quando o cetim é renderizado de forma estranha. Padrão: "
"detectar e corrigir automaticamente um trilho invertido."

#: lib/elements/satin_column.py:378 lib/elements/stroke.py:498
msgid "Swap rails"
msgstr "trocar trilhos"

#: lib/elements/satin_column.py:379
msgid ""
"Swaps the first and second rails of the satin column, affecting which side "
"the thread finished on as well as any sided properties"
msgstr ""
"Troca o primeiro e o segundo trilho da coluna de cetim, alterando o lado em "
"que a linha termina e outras propriedades laterais"

#: lib/elements/satin_column.py:390
msgid "Length of stitches for start and end point connections."
msgstr "Comprimento dos pontos das conexões inicial e final."

#: lib/elements/satin_column.py:412
msgid "Running Stitch Position"
msgstr "Posição do ponto corrido"

#: lib/elements/satin_column.py:413
msgid ""
"Position of running stitches between the rails. 0% is along the first rail, "
"50% is centered, 100% is along the second rail."
msgstr ""
"Posição dos pontos corridos entre os trilhos: 0% irá pelo primeiro trilho, "
"50% irá pelo centro e 100% irá pelo segundo trilho."

#: lib/elements/satin_column.py:421
msgid "Start at nearest point"
msgstr "Iniciar no ponto mais próximo"

#: lib/elements/satin_column.py:422
msgid ""
"Start at nearest point to previous element. A start position command will "
"overwrite this setting."
msgstr ""
"Iniciar no ponto mais próximo do elemento anterior. Um comando de posição "
"inicial substituirá esta configuração."

#: lib/elements/satin_column.py:429
msgid "End at nearest point"
msgstr "Terminar no ponto mais próximo"

#: lib/elements/satin_column.py:430
msgid ""
"End at nearest point to the next element. An end position command will "
"overwrite this setting."
msgstr ""
"Terminar no ponto mais próximo do elemento seguinte. Um comando de posição "
"final substituirá esta configuração."

#: lib/elements/satin_column.py:436 inx/inkstitch_fill_to_satin.inx:16
msgid "Contour underlay"
msgstr "subcamada de contorno"

#: lib/elements/satin_column.py:436 lib/elements/satin_column.py:443
#: lib/elements/satin_column.py:457 lib/elements/satin_column.py:469
#: lib/elements/satin_column.py:484
msgid "Contour Underlay"
msgstr "subcamada de contorno"

#: lib/elements/satin_column.py:443 lib/elements/satin_column.py:500
#: lib/sew_stack/stitch_layers/running_stitch/running_stitch_layer.py:20
#: inx/inkstitch_knockdown_fill.inx:18
msgid "Stitch length"
msgstr "comprimento do ponto"

#: lib/elements/satin_column.py:450 lib/elements/satin_column.py:507
#: lib/elements/stroke.py:178
msgid "Stitch tolerance"
msgstr "tolerância do ponto"

#: lib/elements/satin_column.py:452
msgid ""
"All stitches must be within this distance from the path. A lower tolerance "
"means stitches will be closer together. A higher tolerance means sharp "
"corners may be rounded. "
msgstr ""
"Todos os pontos devem ficar dentro desta distância do caminho. Tolerância "
"menor aproxima os pontos; tolerância maior pode arredondar cantos agudos. "

#: lib/elements/satin_column.py:467
msgid "Inset distance (fixed)"
msgstr "Distância de recuo (fixa)"

#: lib/elements/satin_column.py:468
msgid ""
"Shrink the outline by a fixed length, to prevent the underlay from showing "
"around the outside of the satin column."
msgstr ""
"Encolher o contorno por um comprimento fixo para impedir que a subcamada "
"apareça ao redor da coluna de cetim."

#: lib/elements/satin_column.py:481
msgid "Inset distance (proportional)"
msgstr "Distância de recuo (proporcional)"

#: lib/elements/satin_column.py:482
msgid ""
"Shrink the outline by a proportion of the column width, to prevent the "
"underlay from showing around the outside of the satin column."
msgstr ""
"Encolher o contorno proporcionalmente à largura da coluna para impedir que a"
" subcamada apareça ao redor da coluna de cetim."

#: lib/elements/satin_column.py:493 inx/inkstitch_fill_to_satin.inx:15
msgid "Center-walk underlay"
msgstr "Subcamada central"

#: lib/elements/satin_column.py:493 lib/elements/satin_column.py:500
#: lib/elements/satin_column.py:515 lib/elements/satin_column.py:528
#: lib/elements/satin_column.py:538
msgid "Center-Walk Underlay"
msgstr "Subcamada central"

#: lib/elements/satin_column.py:509
msgid ""
"All stitches must be within this distance from the path. A lower tolerance "
"means stitches will be closer together. A higher tolerance means sharp "
"corners may be rounded. Defaults to stitch length."
msgstr ""
"Todos os pontos devem ficar dentro desta distância do caminho. Tolerância "
"menor aproxima os pontos; tolerância maior pode arredondar cantos agudos. O "
"padrão é o comprimento do ponto."

#: lib/elements/satin_column.py:526
msgid ""
"For an odd number of repeats, this will reverse the direction the satin "
